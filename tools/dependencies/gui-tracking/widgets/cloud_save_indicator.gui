						# 		using = bg_circle
						# 		parentanchor = top|right
						# 		visible = "[MPChatNewMessage]"
						# 		size = { 10 10 }
	
						# 		pieslice_no_highlight = {
						# 			alwaystransparent = yes
						# 			texture = "gfx/interface/pie_charts/pie_chart_blue_progress.dds"
