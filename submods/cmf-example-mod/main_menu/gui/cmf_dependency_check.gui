types cmf_dependency_check
{
	type FrontEndNews = widget {
		size = { 100% 100% }

		### Original FrontEndNews content
		flowcontainer = {
			parentanchor = bottom|right
			widgetanchor = bottom|right
			position = { -110 -20 }
			spacing = 10

			alwaystransparent = yes
			ignoreinvisible = yes
			visible = yes
			scissor = yes

			newsfeed_carousel = {
				name = "newsfeed_slot_main"
				size = { 451 230 }
				align = left
				datacontext = "[FrontEndMainView.AccessMarketingContainer.AccessSlotByName('main')]"
				tooltip_enabled = no
			}

			newsfeed_carousel = {
				name = "newsfeed_slot_secondary_1"
				size = { 245 230 }
				align = left
				datacontext = "[FrontEndMainView.AccessMarketingContainer.AccessSlotByName('secondary-1')]"
				tooltip_enabled = no

				blockoverride "offset_x" {
					position_x = -245
				}
				blockoverride "current_button_pos" {
					size = { 245 230 }
				}
				blockoverride "next_button_pos" {
					size = { 245 230 }
					position = { 245 0 }
				}
			}

			newsfeed_carousel = {
				name = "newsfeed_slot_secondary_2"
				size = { 245 230 }
				align = left
				datacontext = "[FrontEndMainView.AccessMarketingContainer.AccessSlotByName('secondary-2')]"
				tooltip_enabled = no

				blockoverride "offset_x" {
					position_x = -245
				}
				blockoverride "current_button_pos" {
					size = { 245 230 }
				}
				blockoverride "next_button_pos" {
					size = { 245 230 }
					position = { 245 0 }
				}
			}
		}

		### CMF dependency check popup
		### To use: copy this file into your mod's main_menu/gui/ directory.
		### No localization file needed — all text is inlined below.
		widget = {
			size = { 100% 100% }
			parentanchor = center
			alwaystransparent = no

			visible = "[And( Not( GetVariableSystem.Exists( 'cmf_active' ) ), Not( GetVariableSystem.Exists( 'cmf_dep_dismiss' ) ) )]"

			window = {
				parentanchor = center
				widgetanchor = center
				size = { 460 200 }
				using = bg_window_default_alt
				movable = no
				resizable = no
				alwaystransparent = no

				vbox = {
					using = window_margin_alt
					spacing = 10

					text_single = {
						raw_text = "#T Missing Dependency#!"
						align = center
					}

					text_multi = {
						layoutpolicy_horizontal = expanding
						raw_text = "A mod you have enabled requires the #bold Community Mod Framework#! to be enabled. Please enable it in the mod manager."
						align = center
						autoresize = yes
						max_width = 400
					}

					expand = {}

					button_regular = {
						size = { 180 40 }
						raw_text = "Enable"
						onclick = "[GetVariableSystem.Set( 'cmf_dep_auto_enable', 'yes' )]"
						onclick = "[FrontEndMainView.ToggleOpenMods]"
						onclick = "[GetVariableSystem.Set( 'cmf_dep_dismiss', 'yes' )]"
						tooltip_enabled = no
					}
				}
			}
		}
	}
}

### Auto-enable CMF when the user clicks "Enable" on the dependency popup.
### Overrides playset_create_button — always visible when the mods panel opens.
types cmf_dependency_auto_enable
{
	type playset_create_button = vbox {
		layoutpolicy_horizontal = expanding

		### Original playset_create_button content
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 5
			margin = {10 0}

			editbox_single = {
				name = "create_playset_editbox"
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = fixed
				tooltipwidget = {
					LeftClickButtonTooltip = {
						blockoverride "onclick_text" {
							text = "MODS_GUI_PLAYSET_LABEL_TOOLTIP"
						}
					}
				}

				blockoverride "editbox_label" {
					text = "MODS_GUI_PLAYSET_LABEL"
				}
			}

			button_regular = {
				text = "MODS_GUI_CREATE_PLAYSET"
				tooltipwidget = {BasicFunctionalTooltip = {}}

				action_tooltip = {
					click_type = left
					click_mode = single
					title = "[ModsGui.CreatePlaysetTooltip(PdxGuiEditboxGetText(PdxGuiWidget.AccessParent.FindChild('create_playset_editbox')))]"
					on_action = "[ModsGui.CreatePlayset(PdxGuiEditboxGetText(PdxGuiWidget.AccessParent.FindChild('create_playset_editbox')))]"
					on_action = "[PdxClearEditBoxText(PdxGuiWidget.AccessParent.FindChild('create_playset_editbox'))]"
					enabled = "[ModsGui.CanCreatePlayset(PdxGuiEditboxGetText(PdxGuiWidget.AccessParent.FindChild('create_playset_editbox')))]"
				}
				enabled = "[ModsGui.CanCreatePlayset(PdxGuiEditboxGetText(PdxGuiWidget.AccessParent.FindChild('create_playset_editbox')))]"
				align = center|nobaseline
				using = button_resize_to_fit_text
			}
		}

		### Auto-enable widget — adds CMF to the playset when the flag is set.
		### _show fires only when visibility transitions from false to true,
		### so only the CMF item (where the condition matches) triggers AddMod.
		vbox = {
			layoutpolicy_horizontal = expanding
			datamodel = "[ModsGui.LocalMods]"

			item = {
				widget = {
					size = { 0 0 }
					visible_at_creation = no
					visible = "[And3( GetVariableSystem.Exists( 'cmf_dep_auto_enable' ), EqualTo_string( LocalMod.Name, 'Community Mod Framework & Menu' ), Not( ModsGui.ActivePlayset.ContainsMod( LocalMod.Id ) ) )]"

					state = {
						name = _show
						on_start = "[ModsGui.ActivePlayset.AddMod( LocalMod.Id )]"
						on_start = "[GetVariableSystem.Clear( 'cmf_dep_auto_enable' )]"
					}
				}
			}
		}

		### DEBUG: remove after testing
		widget = {
			visible = no
			size = { 500 600 }
			position = { 10 10 }

			using = bg_window_default_alt

			vbox = {
				margin = { 10 10 }
				spacing = 2

				text_single = {
					raw_text = "#T DEBUG: LocalMod.Name + EqualTo_string#!"
					align = left
				}

				scrollarea = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					scrollbarpolicy_horizontal = always_off
					autoresizescrollarea = yes
					scrollbar_vertical = {
						using = Scrollbar_Vertical
					}
					scrollwidget = {
						vbox = {
							datamodel = "[ModsGui.LocalMods]"
							item = {
								hbox = {
									layoutpolicy_horizontal = expanding
									spacing = 10

									text_single = {
										raw_text = "[SelectLocalization( EqualTo_string( LocalMod.Name, 'Community Mod Framework & Menu' ), '#G TRUE#!', '#R FALSE#!' )]"
										fontsize = 14
									}

									text_single = {
										layoutpolicy_horizontal = expanding
										raw_text = "[LocalMod.Name]"
										fontsize = 14
										align = left
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
