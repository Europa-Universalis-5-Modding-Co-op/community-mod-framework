# Opens the Advances screen when the Advances Alert is left-clicked.
widget = {
	name = "cmf_example_alert_watcher"
	size = { 0 0 }
	datacontext = "[GetPlayer]"
	visible = "[Country.IsValid]"

	state = {
		name = cmf_example_open_advances
		trigger_when = "[GetVariableSystem.HasValue('cmf_active_alert', 'cmf_alert_example_advances')]"
		on_start = "[OpenLateralGroup('advances_group')]"
		on_start = "[GetVariableSystem.Clear('cmf_active_alert')]"
	}
}
