				text_single = {
					visible = "[And(Player.MakeScope.GetVariable('et_has_run').IsSet, Not(EqualTo_CFixedPoint(Player.MakeScope.GetVariable('et_2_passed').GetValue, '(CFixedPoint)1')))]"
					fontsize = 14
					text = "ET_FAIL"
				}
			}

			# Result: PASS
			# -- Test 3 --------------------------------------
			hbox = {
				layoutpolicy_horizontal = expanding
				ignoreinvisible = yes
