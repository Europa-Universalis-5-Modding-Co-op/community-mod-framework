		# =======================================================
		# Section 8: Countryless Client Tests (76-89)
		# =======================================================
		# No run button: a button's onclick is an Execute, which is the mechanism
		# under test. et_nc_core self-starts and finishes about 4 seconds in.

		text_single = {
			layoutpolicy_horizontal = expanding
			fontsize = 16
			text = "ET_SECTION_NC"
			margin_top = 12
		}

		text_multi = {
			layoutpolicy_horizontal = expanding
			autoresize = yes
			fontsize = 12
			text = "ET_NC_INSTRUCTIONS"
		}

		# Sets a GUI variable and nothing else, so it works with no player
		# country. et_nc_core's reset widget does the actual clearing.
		hbox = {
			button_regular = {
				text = "ET_NC_RESET"
				minimumsize = { 180 30 }
				fontsize = 14
				onclick = "[GetVariableSystem.Set('et_nc_reset', '1')]"
				tooltip = "ET_NC_RESET_TOOLTIP"
			}
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 1

			# -- Test 76 -------------------------------------
			# Separates "the Execute was dropped" from "the driver never ran".
			et_nc_bool_row = {
				blockoverride "et_nc_bool_label" { text = "ET_76_LABEL" }
				blockoverride "et_nc_bool_true" { visible = "[GetVariableSystem.Exists('et_nc_fired')]" }
				blockoverride "et_nc_bool_false" { visible = "[Not(GetVariableSystem.Exists('et_nc_fired'))]" }
			}

			# -- Test 77 -------------------------------------
			et_nc_bool_row = {
