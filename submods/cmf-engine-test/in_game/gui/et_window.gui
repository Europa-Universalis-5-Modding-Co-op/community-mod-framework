				blockoverride "et_nc_row_pass" { visible = "[And(GetVariableSystem.Exists('et_nc_done'), Not(GetVariableFromGlobalVariableMap('et_gmap9', MakeScopeFlag('et_nc_absent')).IsSet))]" }
