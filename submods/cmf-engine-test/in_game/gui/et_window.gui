types et_hw_types {
	# Result row for the hidden-window tests (Section 6): label plus a
	# NOT_RUN / PASS / FAIL readout driven by var:et_hw_has_run and the
	# per-test et_NN_passed variable supplied via the blockoverrides.
	type et_hw_row = hbox {
		layoutpolicy_horizontal = expanding
		ignoreinvisible = yes
		spacing = 8

		text_single = {
			layoutpolicy_horizontal = expanding
			fontsize = 14
			block "et_hw_row_label" {
				text = "ET_HW_SECTION"
			}
		}

		text_single = {
			fontsize = 14
			visible = "[Not(Player.MakeScope.GetVariable('et_hw_has_run').IsSet)]"
			text = "ET_NOT_RUN"
		}
		text_single = {
			fontsize = 14
			block "et_hw_row_pass" {
				visible = no
			}
			text = "ET_PASS"
		}
		text_single = {
			fontsize = 14
			block "et_hw_row_fail" {
				visible = no
			}
			text = "ET_FAIL"
		}
	}
}

types et_nc_types {
	# Result row for the countryless suite (Section 8). Reads nothing off Player,
	# because the states this suite runs in have no player country and every
	# Player read there comes back blank.
	type et_nc_row = hbox {
		layoutpolicy_horizontal = expanding
		ignoreinvisible = yes
		spacing = 8

		text_single = {
			layoutpolicy_horizontal = expanding
			fontsize = 14
			block "et_nc_row_label" {
				text = "ET_NC_SECTION"
			}
		}

		text_single = {
			fontsize = 14
			visible = "[Not(GetVariableSystem.Exists('et_nc_done'))]"
			text = "ET_NOT_RUN"
		}
		text_single = {
			fontsize = 14
			block "et_nc_row_pass" {
				visible = no
			}
			text = "ET_PASS"
		}
		text_single = {
			fontsize = 14
			block "et_nc_row_fail" {
				visible = no
			}
			text = "ET_FAIL"
		}
	}

	# Probe row: records what a function actually returns in each client state
	# rather than scoring it, since the expected value is the unknown.
	type et_nc_bool_row = hbox {
		layoutpolicy_horizontal = expanding
		ignoreinvisible = yes
		spacing = 8

		text_single = {
			layoutpolicy_horizontal = expanding
			fontsize = 14
			block "et_nc_bool_label" {
				text = "ET_NC_SECTION"
			}
		}

		text_single = {
			fontsize = 14
			block "et_nc_bool_true" {
				visible = no
			}
			text = "ET_TRUE"
		}
		text_single = {
			fontsize = 14
			block "et_nc_bool_false" {
				visible = no
			}
			text = "ET_FALSE"
		}
	}

	# Result row for the pure-script suite (Section 7b), scored off
	# et_script_has_run.
	type et_script_row = hbox {
		layoutpolicy_horizontal = expanding
		ignoreinvisible = yes
		spacing = 8

		text_single = {
			layoutpolicy_horizontal = expanding
			fontsize = 14
			block "et_script_row_label" {
				text = "ET_NC_SECTION"
			}
		}

		text_single = {
			fontsize = 14
			visible = "[Not(Player.MakeScope.GetVariable('et_script_has_run').IsSet)]"
			text = "ET_NOT_RUN"
		}
		text_single = {
			fontsize = 14
			block "et_script_row_pass" {
				visible = no
			}
			text = "ET_PASS"
		}
		text_single = {
			fontsize = 14
			block "et_script_row_fail" {
				visible = no
			}
			text = "ET_FAIL"
		}
	}

	# Display row for a raw count or string. The value expression lives in the
	# localization entry, so text still names a loc key.
	type et_nc_text_row = hbox {
		layoutpolicy_horizontal = expanding
		ignoreinvisible = yes
		spacing = 8

		text_single = {
			layoutpolicy_horizontal = expanding
			fontsize = 14
			block "et_nc_text_label" {
				text = "ET_NC_SECTION"
			}
		}

		text_single = {
			fontsize = 14
			block "et_nc_text_value" {
				text = "ET_NOT_RUN"
			}
		}
	}
}

window = {
	name = "et_window"
	parentanchor = center
	widgetanchor = center
	size = { 700 800 }
	movable = yes
	using = bg_window_default_alt
	allow_outside = yes
	visible = "[Not(GetVariableSystem.Exists('et_closed'))]"

	vbox = {
		using = window_margin_alt
		spacing = 0

		window_header_alt = {
			blockoverride "header_text_object" {
				header_title = {
					text = "ET_TITLE"
				}
			}
		}

		scrollbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			blockoverride "scrollbox_content" {
				spacing = 4
				margin_right = 20

		# =======================================================
		# Section 1: Country-Scope Variable Map Tests
		# =======================================================

		hbox = {
			button_regular = {
				text = "ET_RUN"
				minimumsize = { 180 30 }
				fontsize = 14
				onclick = "[GetScriptedGui('et_run').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('et_setting', MakeScopeFlag('et_key_a')).End)]"
				tooltip = "ET_RUN_TOOLTIP_COUNTRY"
			}
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 1

			# Result: PASS
			# -- Test 1 --------------------------------------
			hbox = {
				layoutpolicy_horizontal = expanding
				ignoreinvisible = yes
				spacing = 8

				text_single = {
					layoutpolicy_horizontal = expanding
					fontsize = 14
					text = "ET_1_LABEL"
				}

				text_single = {
					fontsize = 14
					visible = "[Not(Player.MakeScope.GetVariable('et_has_run').IsSet)]"
					text = "ET_NOT_RUN"
				}
				text_single = {
					visible = "[And(Player.MakeScope.GetVariable('et_has_run').IsSet, EqualTo_CFixedPoint(Player.MakeScope.GetVariable('et_1_passed').GetValue, '(CFixedPoint)1'))]"
					fontsize = 14
					text = "ET_PASS"
				}
				text_single = {
					visible = "[And(Player.MakeScope.GetVariable('et_has_run').IsSet, Not(EqualTo_CFixedPoint(Player.MakeScope.GetVariable('et_1_passed').GetValue, '(CFixedPoint)1')))]"
					fontsize = 14
					text = "ET_FAIL"
				}
			}

			# Result: PASS
			# -- Test 2 --------------------------------------
			hbox = {
