window = {
	name = "et_window"
	parentanchor = center
	widgetanchor = center
	size = { 700 800 }
	movable = yes
	using = bg_window_default_alt
	allow_outside = yes
	visible = "[Not(GetVariableSystem.Exists('et_closed'))]"

	vbox = {
		using = window_margin_alt
		spacing = 0

		window_header_alt = {
			blockoverride "header_text_object" {
				header_title = {
					text = "ET_TITLE"
				}
			}
		}

		scrollbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			blockoverride "scrollbox_content" {
				spacing = 4
				margin_right = 20

		# =======================================================
		# Section 1: Country-Scope Variable Map Tests
		# =======================================================

		hbox = {
			button_regular = {
				text = "ET_RUN"
				minimumsize = { 180 30 }
				fontsize = 14
				onclick = "[GetScriptedGui('et_run').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('et_setting', MakeScopeFlag('et_key_a')).End)]"
				tooltip = "ET_RUN_TOOLTIP_COUNTRY"
			}
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 1

			# Result: PASS
			# -- Test 1 --------------------------------------
			hbox = {
				layoutpolicy_horizontal = expanding
				ignoreinvisible = yes
				spacing = 8

				text_single = {
					layoutpolicy_horizontal = expanding
					fontsize = 14
					text = "ET_1_LABEL"
				}

				text_single = {
					fontsize = 14
					visible = "[Not(Player.MakeScope.GetVariable('et_has_run').IsSet)]"
					text = "ET_NOT_RUN"
				}
				text_single = {
					visible = "[And(Player.MakeScope.GetVariable('et_has_run').IsSet, EqualTo_CFixedPoint(Player.MakeScope.GetVariable('et_1_passed').GetValue, '(CFixedPoint)1'))]"
					fontsize = 14
					text = "ET_PASS"
				}
				text_single = {
					visible = "[And(Player.MakeScope.GetVariable('et_has_run').IsSet, Not(EqualTo_CFixedPoint(Player.MakeScope.GetVariable('et_1_passed').GetValue, '(CFixedPoint)1')))]"
					fontsize = 14
					text = "ET_FAIL"
				}
			}

			# Result: PASS
			# -- Test 2 --------------------------------------
			hbox = {
				layoutpolicy_horizontal = expanding
				ignoreinvisible = yes
				spacing = 8

				text_single = {
					layoutpolicy_horizontal = expanding
					fontsize = 14
					text = "ET_2_LABEL"
				}

				text_single = {
					fontsize = 14
					visible = "[Not(Player.MakeScope.GetVariable('et_has_run').IsSet)]"
					text = "ET_NOT_RUN"
				}
				text_single = {
					visible = "[And(Player.MakeScope.GetVariable('et_has_run').IsSet, EqualTo_CFixedPoint(Player.MakeScope.GetVariable('et_2_passed').GetValue, '(CFixedPoint)1'))]"
					fontsize = 14
