		# =======================================================
		# Section 9: on_action, Timing and Persistence (104-107)
		# =======================================================
		# 104 and 105 count fires, so the count is the result: 1 means a no-scope
		# hook, a per-country hook would run to hundreds. 105 and 107 need elapsed
		# time and a second game, so both are display rows.

		text_single = {
			layoutpolicy_horizontal = expanding
			fontsize = 16
			text = "ET_SECTION_PULSE"
			margin_top = 12
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 1

			# -- Test 104 ------------------------------------
			et_nc_text_row = {
				blockoverride "et_nc_text_label" { text = "ET_104_LABEL" }
				blockoverride "et_nc_text_value" { text = "ET_104_VALUE" }
			}

			# -- Test 105 ------------------------------------
			et_nc_text_row = {
				blockoverride "et_nc_text_label" { text = "ET_105_LABEL" }
				blockoverride "et_nc_text_value" { text = "ET_105_VALUE" }
			}

			# -- Test 107 ------------------------------------
			# et_nc_carried is set only when et_nc_persist was already present as
			# this game's map came up, so FALSE on the first game of a client run
			# and TRUE on the second is the claim holding.
			et_nc_bool_row = {
				blockoverride "et_nc_bool_label" { text = "ET_107_LABEL" }
				blockoverride "et_nc_bool_true" { visible = "[GetVariableSystem.HasValue('et_nc_carried', 'yes')]" }
				blockoverride "et_nc_bool_false" { visible = "[GetVariableSystem.HasValue('et_nc_carried', 'no')]" }
			}
		}

			} # end blockoverride "scrollbox_content"
		} # end scrollbox
	}
}
