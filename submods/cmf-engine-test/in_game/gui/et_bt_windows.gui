# Building-handle round trip rig (tests 147, 148). A building stored in a variable list,
# read back into a datamodel, downcast with Scope.GetBuilding and acted on by ToggleBuilding
# is the shape Construction Manager's Building Cleanup close and reopen runs on, and it has
# no vanilla or prior mod precedent.
#
# The seed in et_run_script fills the list and sets et_bt_fire; the driver is pinned so the
# gate going true makes the hidden->shown edge that fires _show. The datamodel is a
# statically-visible sibling rather than a child of the pinned driver, so its items are
# instantiated by the time the sweep fires.

widget = {
	name = "et_bt_core"
	widgetid = et_bt_core
	layer = top
	visible = "[EqualTo_CFixedPoint('(CFixedPoint)0', '(CFixedPoint)0')]"
	position = { -10000 1 }

	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And(GetPlayer.Exists, Player.MakeScope.GetVariable('et_bt_fire').IsSet)]"

		state = {
			name = _show
			duration = 0.4
			on_finish = "[PdxGuiTriggerAllAnimations('et_bt_toggle')]"
			next = et_bt_settle
		}

		state = {
			name = et_bt_settle
			duration = 0.4
			on_finish = "[GetScriptedGui('et_bt_check').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}
	}

	widget = {
		datamodel = "[GetPlayer.MakeScope.GetList('et_bt_list')]"
		item = {
			widget = {
				datacontext = "[Scope.GetBuilding]"
				state = {
					name = et_bt_toggle
					on_finish = "[GetScriptedGui('et_bt_seen').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('et_bt_b', Building.MakeScope).End)]"
					on_finish = "[ToggleBuilding(Building.Self)]"
				}
			}
		}
	}
}
