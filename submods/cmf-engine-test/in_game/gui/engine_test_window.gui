		# =======================================================
		# Section 4: GUI Map Read Tests (var: numeric keys)
		# Run global tests first to seed engine_test_gui_map.
		# Each row tries a different approach to read the value.
		# Working approaches show "42" / "99"; broken show "default".
		# =======================================================

		text_single = {
			fontsize = 14
			text = "ENGINE_TEST_GUI_SECTION"
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 1
			visible = "[DataModelHasItems(GetGlobalMapKeys('engine_test_gui_map'))]"

			datamodel = "[GetGlobalMapKeys('engine_test_gui_map')]"

			item = {
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 1

					# Approach A: GetVariableFromGlobalVariableMap with Scope
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						text_single = { fontsize = 12 raw_text = "A: GetVarFromGlobalMap(name, Scope) =" }
						text_single = { fontsize = 12 text = "[GetVariableFromGlobalVariableMap('engine_test_gui_map', Scope).GetValue]" }
					}

					# Approach B: GetVariableFromGlobalVariableMap with Scope.Self
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						text_single = { fontsize = 12 raw_text = "B: GetVarFromGlobalMap(name, Scope.Self) =" }
						text_single = { fontsize = 12 text = "[GetVariableFromGlobalVariableMap('engine_test_gui_map', Scope.Self).GetValue]" }
					}

					# Approach C: Read action map (flag value) with Scope
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						text_single = { fontsize = 12 raw_text = "C: action flag via Scope =" }
						text_single = { fontsize = 12 text = "[GetVariableFromGlobalVariableMap('engine_test_gui_action', Scope).GetFlagName]" }
					}

					# Approach D: Read action map (flag value) with Scope.Self
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						text_single = { fontsize = 12 raw_text = "D: action flag via Scope.Self =" }
						text_single = { fontsize = 12 text = "[GetVariableFromGlobalVariableMap('engine_test_gui_action', Scope.Self).GetFlagName]" }
					}

					# Show raw scope info
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						text_single = { fontsize = 12 raw_text = "Key GetValue =" }
						text_single = { fontsize = 12 text = "[Scope.GetValue]" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						text_single = { fontsize = 12 raw_text = "Key GetFlagName =" }
						text_single = { fontsize = 12 text = "[Scope.GetFlagName]" }
					}

					# Separator between entries
					widget = {
						layoutpolicy_horizontal = expanding
						size = { 0 4 }
					}
				}
			}
		}

		text_single = {
			visible = "[Not(DataModelHasItems(GetGlobalMapKeys('engine_test_gui_map')))]"
			fontsize = 12
			raw_text = "(Run global tests first to seed the GUI map)"
		}
			} # end blockoverride "scrollbox_content"
		} # end scrollbox
	}
