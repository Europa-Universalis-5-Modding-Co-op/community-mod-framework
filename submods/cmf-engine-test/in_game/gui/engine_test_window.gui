				}
				text_single = {
					visible = "[And(Player.MakeScope.GetVariable('engine_test_has_run').IsSet, Not(EqualTo_CFixedPoint(Player.MakeScope.GetVariable('engine_test_3_passed').GetValue, '(CFixedPoint)1')))]"
					fontsize = 14
					text = "ENGINE_TEST_FAIL"
				}
			}
		}

		# -- Separator ---------------------------------------
		widget = {
			layoutpolicy_horizontal = expanding
			size = { 0 2 }
		}

		# =======================================================
		# Section 2: Global Variable Map Tests
		# =======================================================

		hbox = {
			button_regular = {
				text = "ENGINE_TEST_RUN_GLOBAL"
				minimumsize = { 180 30 }
				fontsize = 14
				onclick = "[GetScriptedGui('engine_test_run_global').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('setting', MakeScopeFlag('engine_test_key_a')).End)]"
