# Country transfer detector: monitors GetPlayer tag via GetVariableSystem.
# On the first country of a session it fires the acquire scripted GUI. When the stored tag
# differs from the current tag it fires the transfer scripted GUI with scope:old_country and
# scope:new_country. Both then update the stored tag and re-trigger to keep monitoring.
widget = {
	name = "cmf_country_transfer_monitor"
	size = { 0 0 }
	visible = "[IsPlayerValid]"

	# First country of the session. There is nothing to transfer from, but edits made
	# before the country existed are waiting to be applied.
	hbox = {
		visible = "[Not(GetVariableSystem.Exists('cmf_player_tag'))]"
		state = {
			name = cmf_country_acquired_detect
			trigger_on_create = yes
			on_finish = "[GetScriptedGui('_cmf_on_country_acquired').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			on_finish = "[GetVariableSystem.Set('cmf_player_tag', Localize('CMF_PLAYER_TAG'))]"
			on_finish = "[PdxGuiWidget.TriggerAnimation('cmf_country_acquired_detect')]"
		}
	}

	# Monitor for tag changes
	hbox = {
		visible = "[And(And(GetVariableSystem.Exists('cmf_player_tag'), Not(EqualTo_string(Localize('CMF_PLAYER_TAG'), GetVariableSystem.Get('cmf_player_tag')))), GetCountry(GetVariableSystem.Get('cmf_player_tag')).IsValid)]"
		state = {
			name = cmf_country_transfer_detect
			trigger_on_create = yes
			on_finish = "[GetScriptedGui('_cmf_on_country_transfer').Execute(GuiScope.AddScope('new_country', GetPlayer.MakeScope).AddScope('old_country', GetCountry(GetVariableSystem.Get('cmf_player_tag')).MakeScope).End)]"
			on_finish = "[GetVariableSystem.Set('cmf_player_tag', Localize('CMF_PLAYER_TAG'))]"
			on_finish = "[PdxGuiWidget.TriggerAnimation('cmf_country_transfer_detect')]"
		}
	}
}
