# Country transfer detector: monitors GetPlayer tag via GetVariableSystem.
# On the first country of a session it fires the acquire scripted GUI. When the stored tag
# differs from the current tag it fires the transfer scripted GUI with scope:old_country and
# scope:new_country. Both then update the stored tag.
# The outer gate keeps every expression below off an invalid GetPlayer, and visible_at_creation
# pins each branch hidden so a gate that is already true at creation still fires _show.
widget = {
	name = "cmf_country_transfer_monitor"
	size = { 0 0 }
	visible = "[CMFHasPlayerCountry]"

	# First country of this game, or a tag left over from a previous game in this client run.
	# Either way there is nothing to transfer from, so only the stored tag is recorded.
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[Not(CMFStoredPlayerTagIsCurrent)]"

		state = {
			name = _show
			on_start = "[GetVariableSystem.Set('cmf_player_tag', Localize('CMF_PLAYER_TAG'))]"
		}
	}

	# Monitor for tag changes
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And(CMFStoredPlayerTagIsCurrent, Not(EqualTo_string(Localize('CMF_PLAYER_TAG'), GetVariableSystem.Get('cmf_player_tag'))))]"

		state = {
			name = _show
			on_start = "[GetScriptedGui('_cmf_on_country_transfer').Execute(GuiScope.AddScope('new_country', GetPlayer.MakeScope).AddScope('old_country', GetCountry(GetVariableSystem.Get('cmf_player_tag')).MakeScope).End)]"
			on_start = "[GetVariableSystem.Set('cmf_player_tag', Localize('CMF_PLAYER_TAG'))]"
		}
	}
}
