widget = {
	name = "cmf_init_popup"
	size = { 100% 100% }
	layer = top
	datacontext = "[GetPlayer]"
	visible = "[And(Country.IsValid, Not(GetScriptedGui('cmf_is_active').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)))]"
	alwaystransparent = no

	background = {
		texture = "gfx/interface/component_tiles/tile_background_center.dds"
		spriteType = CorneredTiled
		spriteborder = { 15 15 }
		alpha = 0.5
	}

	window = {
		parentanchor = center
		widgetanchor = center
		size = { 460 200 }
		using = bg_window_default_alt
		movable = no
		resizable = no
		alwaystransparent = no

		vbox = {
			using = window_margin_alt
			spacing = 10

			text_single = {
				text = "cmf_init_popup_title"
				default_format = "#T"
				align = center
			}

			text_multi = {
				layoutpolicy_horizontal = expanding
				text = "cmf_init_popup_desc"
				align = center
				autoresize = yes
				max_width = 400
			}

			expand = {}

			button_wax = {
				blockoverride "button_texture" {
					texture = "gfx/interface/buttons/button_wax_yellow.dds"
				}
				size = { 220 45 }
				text = "cmf_init_popup_button"
				onclick = "[GetScriptedGui('cmf_set_active').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
		}
	}
}
