                        blockoverride "base_color" {
                            using = color_gold_texture
                        }
                    }
                    cmf_action_bar_button = {
                        visible = "[GetVariableSystem.HasValue(Concatenate(Scope.GetFlagName, '_abclr'), 'gold_dark')]"
                        blockoverride "base_color" {
                            using = color_gold_dark_texture
                        }
                    }
                    cmf_action_bar_button = {
                        visible = "[GetVariableSystem.HasValue(Concatenate(Scope.GetFlagName, '_abclr'), 'grey')]"
                        blockoverride "base_color" {
                            using = color_grey_texture
                        }
                    }
                    cmf_action_bar_button = {
