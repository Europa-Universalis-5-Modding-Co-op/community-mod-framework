# Vanilla topbar layout values: in_game/gui/ingame_topbar.gui:9 @topbar_height, :10 @panel_bar_height, :15 @left_panel_width, :17 @panel_x
@topbar_height = 40
@panel_bar_height = 90
@left_panel_width = 570
@panel_x = 0

types cmf_action_bar {

    type cmf_action_bar_bottom_left = cmf_action_bar_bottom {
        visible = "[And4(
            Not(Or(LeftView.IsShown, IsLateralViewFullScreen)),
            Not(GetVariableSystem.Exists('cmf_hide_action_bar')),
            EqualTo_CFixedPoint(CMMSettingValue('cmf_core__action_bar_position'), '(CFixedPoint)1'),
            Or(
                Or(Not(GetPlayer.MakeScope.GetVariableFromVariableMap('cmm', MakeScopeFlag('cmf_core__action_bar_buttons_i1_f1')).IsSet), EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariableFromVariableMap('cmm', MakeScopeFlag('cmf_core__action_bar_buttons_i1_f1')).GetValue, '(CFixedPoint)1')),
                DataModelHasItems(GetPlayer.MakeScope.GetList('cmf_action_bar_active_elements'))
            )
        )]"
        position = { 200 0 }
        parentanchor = bottom|left
    }

    type cmf_action_bar_bottom_right = cmf_action_bar_bottom {
        visible = "[And5(
            Not(Or(RightView.IsShown, IsLateralViewFullScreen)),
            Not(AccessMessageLog.IsExpanded),
            Not(GetVariableSystem.Exists('cmf_hide_action_bar')),
            Or(
                Not(CMMSettingIsRegistered('cmf_core__action_bar_position')),
                EqualTo_CFixedPoint(CMMSettingValue('cmf_core__action_bar_position'), '(CFixedPoint)3')
            ),
            Or(
                Or(Not(GetPlayer.MakeScope.GetVariableFromVariableMap('cmm', MakeScopeFlag('cmf_core__action_bar_buttons_i1_f1')).IsSet), EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariableFromVariableMap('cmm', MakeScopeFlag('cmf_core__action_bar_buttons_i1_f1')).GetValue, '(CFixedPoint)1')),
                DataModelHasItems(GetPlayer.MakeScope.GetList('cmf_action_bar_active_elements'))
            )
        )]"
        position = { -200 0 }
        parentanchor = bottom|right
    }

    type cmf_action_bar_bottom_right_above_news = cmf_action_bar_bottom {
        visible = "[And5(
            Not(Or(RightView.IsShown, IsLateralViewFullScreen)),
            AccessMessageLog.IsExpanded,
            Not(GetVariableSystem.Exists('cmf_hide_action_bar')),
            Or(
                Not(CMMSettingIsRegistered('cmf_core__action_bar_position')),
                EqualTo_CFixedPoint(CMMSettingValue('cmf_core__action_bar_position'), '(CFixedPoint)3')
            ),
            Or(
                Or(Not(GetPlayer.MakeScope.GetVariableFromVariableMap('cmm', MakeScopeFlag('cmf_core__action_bar_buttons_i1_f1')).IsSet), EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariableFromVariableMap('cmm', MakeScopeFlag('cmf_core__action_bar_buttons_i1_f1')).GetValue, '(CFixedPoint)1')),
                DataModelHasItems(GetPlayer.MakeScope.GetList('cmf_action_bar_active_elements'))
            )
        )]"
        position = { -200 -240 } # -240 matches the news content height: in_game/gui/message_log.gui:145
        parentanchor = bottom|right
    }

    type cmf_action_bar_top = cmf_action_bar_top_tabs {
        visible = "[And4(
            Not(Or(LeftView.IsShown, IsLateralViewFullScreen)),
            Not(GetVariableSystem.Exists('cmf_hide_action_bar')),
            EqualTo_CFixedPoint(CMMSettingValue('cmf_core__action_bar_position'), '(CFixedPoint)2'),
            Or(
                Or(Not(GetPlayer.MakeScope.GetVariableFromVariableMap('cmm', MakeScopeFlag('cmf_core__action_bar_buttons_i1_f1')).IsSet), EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariableFromVariableMap('cmm', MakeScopeFlag('cmf_core__action_bar_buttons_i1_f1')).GetValue, '(CFixedPoint)1')),
                DataModelHasItems(GetPlayer.MakeScope.GetList('cmf_action_bar_active_elements'))
            )
        )]"
    }

    type cmf_action_bar_bottom = hbox {
        minimumsize = { -1 40 }
        maximumsize = { -1 40 }
        using = bg_mapmenu_tab
        using = Animation_Show_Hide_UI
        alwaystransparent = no
        allow_outside = yes
        filter_mouse = left|right

        icon = {
            using = left_decoration_icon
            size = { 50 40 }
        }

        cmf_action_bar_horizontal = {}

        icon = {
            using = right_decoration_icon
            size = { 50 40 }
        }
    }

    type cmf_action_bar_horizontal = hbox {
        margin = { 10 3 }
        spacing = 4
        set_parent_size_to_minimum = yes

        hbox = {
            spacing = 4
            datamodel = "[GetPlayer.MakeScope.GetList('cmf_action_bar_active_elements')]"
            visible = "[DataModelHasItems(GetPlayer.MakeScope.GetList('cmf_action_bar_active_elements'))]"

            item = {
                widget = {
                    size = { 34 34 }
                    visible = "[Or(
                        Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.GetVariableFromVariableMap('cmf_has_sgui', MakeScopeFlag(Scope.GetFlagName)).GetValue, '(CFixedPoint)0')),
                        GetScriptedGui(Select_CString(CMFActionBarSynced, Scope.GetFlagName, 'cmf_action_bar_fallback')).IsShown(GuiScope
                            .SetRoot(GetPlayer.MakeScope)
                            .End
                        )
                    )]"

                    # Each colour branch below reads this instead of localizing the key itself, which
                    # one of them would do on every frame.
                    state = {
                        name = cmf_cache_action_bar_color
                        trigger_on_create = yes
                        on_start = "[GetVariableSystem.Set(Concatenate(Scope.GetFlagName, '_abclr'), Localize(Concatenate(Scope.GetFlagName, '_color')))]"
                    }

                    cmf_action_bar_button = {
                        visible = "[GetVariableSystem.HasValue(Concatenate(Scope.GetFlagName, '_abclr'), 'blue')]"
                        blockoverride "base_color" {
                            using = color_blue_texture
                        }
                    }
                    cmf_action_bar_button = {
                        visible = "[GetVariableSystem.HasValue(Concatenate(Scope.GetFlagName, '_abclr'), 'bone')]"
                        blockoverride "base_color" {
                            using = color_bone_texture
                        }
                    }
                    cmf_action_bar_button = {
                        visible = "[GetVariableSystem.HasValue(Concatenate(Scope.GetFlagName, '_abclr'), 'brown_leather')]"
                        blockoverride "base_color" {
                            using = color_brown_leather_texture
                        }
                    }
                    cmf_action_bar_button = {
                        visible = "[GetVariableSystem.HasValue(Concatenate(Scope.GetFlagName, '_abclr'), 'intense_bg_blue')]"
                        blockoverride "base_color" {
                            using = color_intense_bg_blue_texture
                        }
                    }
                    cmf_action_bar_button = {
                        visible = "[GetVariableSystem.HasValue(Concatenate(Scope.GetFlagName, '_abclr'), 'dark_turquoise')]"
                        blockoverride "base_color" {
