template LobbyTopbarBg {
	screen_grab = {
		visible = "[Not(IsScreenGrabWorking)]"
		id = "shared_background"
		texture_ref = "ScreenGrabTexture0"
		constant_buffer_ref = "ScreenGrabConstants0"
		fullscreen = yes
		post_effect = Blur
	}

	background = {
		using = color_dark_blue_texture
		alpha = 0.9
	}

	background = {
		using = color_light_blue_texture
		alpha = 0.1
	}

	background = {
		using = tile_background_squared_texture

		modify_texture = {
			using = color_bg_blue_texture
		}

		modify_texture = {
			visible = "[Not(LobbyView.HasSelectedPlayable)]"
			texture = "gfx/interface/component_overlay/striped_texture.dds"
			texture_density = 2
			spriteType = corneredtiled
			spriteborder = { 0 0 }
			blend_mode = overlay
		}

		modify_texture = {
			visible = "[LobbyView.HasSelectedPlayable]"
			texture = "[GetGraphicalCultureTextureForCountry('top_bar_bg', LobbyView.GetSelectedPlayable.GetCountry.Self)]"
			texture_density = 2
			spriteType = corneredtiled
			spriteborder = { 0 0 }
			blend_mode = overlay
			alpha = 0.3
		}
	}

	background = {
		using = tile_frame_horizontal_texture
		alpha = 1

		modify_texture = {
			using = color_new_gold_texture
			blend_mode = overlay
		}
		modify_texture = {
			using = color_bg_blue_texture
			blend_mode = overlay
			alpha = 0.2
		}
		modify_texture = {
			using = color_purple_texture
			blend_mode = multiply
			alpha = 0.2
		}
	}
}


template country_specific_description_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "COUNTRY_SPECIFIC_LOBBY_DESCRIPTION_TT"
		}
		
		blockoverride "title_icon_texture" {
			texture = "gfx/interface/icons/flat_icons/country_bonus.dds"
		}

		blockoverride "concept_link" {
			text = "[country|E]"
		}

		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				visible = "[EqualTo_int32(UniqueContentDescription.GetAmountUniqueContentFlavor, '(int32)0')]"
				textcontext = "NONE"
			}

			TooltipTextBlock = {
				visible = "[GreaterThan_int32(UniqueContentDescription.GetAmountUniqueContentFlavor, '(int32)0')]"
				blockoverride "set_textcontext" {
					ontextcontextchanged = "[SetRowListWithTitleFromTextContext(PdxGuiWidget.AccessSelf)]"
				}
				textcontext = "[UniqueContentDescription.GetUniqueContentFlavorLobbyDesc]"
				
				blockoverride "text" {
					text = "[RowList.GetTitle.GetStringView]"
				}
			}

			TooltipScrolledContentSection = {
				visible = "[GreaterThan_int32(UniqueContentDescription.GetAmountUniqueContentFlavor, '(int32)0')]"
				
				blockoverride "section_content" {
					block "country_culture_datacontext" {
						datacontext = "[GameLobby.GetSelectedCountry]"
					}
					block "country_specific_bonuses_datamodel" {
						datamodel = "[GameLobby.GetUniqueCountryBonuses]"
					}
					item = {
						TooltipListBase = {
							blockoverride "block_title" {
								raw_text = "[UniqueContentTypeCategory.GetConcept.GetNameWithIcon|e] ([GetDataModelSize(UniqueContentTypeCategory.GetItems)|L])"
							}

							TooltipContentSection = {
								blockoverride "section_content" {
									margin_right = 10
									datamodel = "[UniqueContentTypeCategory.GetItems]"
									item = {
										unique_content_item = {}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}


types MultiplayerLobby
{
	# type LobbyViewTitle = textbox {
	# 	size = { 100% 24 }
	# 	using = Font_Type_Standard
	# 	position = { 0 10 }
	# 	align = center
	# }

	type unique_content_type_category_item = widget {
		block "unique_content_type_category_size" {
			size = { @unique_content_width @unique_content_height }
		}

		hbox = {
			margin = { 10 0 }
			spacing = 10
			widget = {
				size = { 40 40 }
	
				using = bg_circle_piechart_big

				blockoverride "inner_circle_piechart" {}

				icon = {
					parentanchor = center
					size = { 80% 80% }
					block "unique_content_type_category_icon" {
						texture = "[GetConceptTexture_StringView(UniqueContentTypeCategory.GetConceptKey)]"
					}
				}
			}

			text_single = {
				using = layoutpolicy_expanding
				autoresize = no
				using = Font_Size_Medium
				block "unique_content_type_category_text" {
					text = "[GetDataModelSize(UniqueContentTypeCategory.GetItems)|L]"
				}
			}

			block "unique_content_type_category_tooltip" {
				tooltipwidget = {
					using = unique_content_type_category_tooltip_template
				}
			}
		}
	}

	type dlc_banner = button {
		texture_density = 3
		texture = "gfx/interface/alerts/dlc_alert_background.dds"

		icon = {
			parentanchor = center
			size = "[PdxGuiWidget.KeepRatioFromWidthPercent('(float)1.0', '(float)0.75')]"
			texture = "[GameDLC.GetIcon]"
			glow = {
					name = "drop_shadow"
					glow_radius = 5
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.2
				}
		}

		onmousehierarchyenter = "[PdxGuiWidget.SetHighlightCountry(GameDLC.GetFirstRelatedCountry)]"

		action_tooltip = {
			title = "GAME_DLC_SHOW_VIEW_CLICK"
			on_action = "[ShowDLCView(GameDLC.Self)]"
		}

		tooltipwidget = {
			ExtraContentTooltipType = {
				# blockoverride "title_header_color" { tintcolor = "[GetColorDLC(DlcEntry.Filename)]"}
				blockoverride "title_text" { text = "[GameDLC.GetName]" }
				blockoverride "owned_text" { text = "GAME_DLC_TOOLTIP_OWNED" }
				blockoverride "installed_text" { text = "GAME_DLC_TOOLTIP_INSTALLED" }
				blockoverride "mounted_text" { text = "GAME_DLC_TOOLTIP_MOUNTED" }
				blockoverride "activated_text" { text = "GAME_DLC_TOOLTIP_ACTIVATED" }
				blockoverride "ExtraContentTooltipType_background_texture" { texture = "[GameDLC.GetTooltipBackground]" }

				blockoverride "flavor_text" {
					text = "[GameDLC.GetTooltipDesc]"
				}
			}
		}
	}

	type short_dlc_banner = button {
		texture = "gfx/interface/alerts/dlc_alert_background_purple_short.dds"
		texture_density = 4

		onmousehierarchyenter = "[PdxGuiWidget.SetHighlightCountry(GameDLC.GetFirstRelatedCountry)]"

		action_tooltip = {
			title = "GAME_DLC_SHOW_VIEW_CLICK"
			on_action = "[ShowDLCView(GameDLC.Self)]"
		}

		icon = {
			parentanchor = center
			size = "[PdxGuiWidget.KeepRatioFromWidthPercent('(float)1.0', '(float)0.75')]"
			position = { 0 -4 }
			texture = "[GameDLC.GetIcon]"
		}

		tooltipwidget = {
			ExtraContentTooltipType = {
				# blockoverride "title_header_color" { tintcolor = "[GetColorDLC(DlcEntry.Filename)]"}
				blockoverride "title_text" { text = "[GameDLC.GetName]" }
				blockoverride "owned_text" { text = "GAME_DLC_TOOLTIP_OWNED" }
				blockoverride "installed_text" { text = "GAME_DLC_TOOLTIP_INSTALLED" }
				blockoverride "mounted_text" { text = "GAME_DLC_TOOLTIP_MOUNTED" }
				blockoverride "activated_text" { text = "GAME_DLC_TOOLTIP_ACTIVATED" }
				blockoverride "ExtraContentTooltipType_background_texture" { texture = "[GameDLC.GetTooltipBackground]" }

				blockoverride "flavor_text" {
					text = "[GameDLC.GetTooltipDesc]"
				}
			}
		}
	}

	type LobbySubHeader = widget {
		layoutpolicy_horizontal = expanding
		size = { -1 30 }

		hbox = {
			margin_right = 10
			layoutpolicy_horizontal = expanding

			hbox = {
				layoutpolicy_horizontal = expanding
				margin = { 10 5 }
				using = bg_name_banner_left
				text_single = {
					layoutpolicy_horizontal = expanding
					autoresize = no
					align = nobaseline
					using = Font_Type_Headers

					block "text" {
						using = text_default_text_template
					}
				}
			}
		}
	}

	type unique_content_item_specific = widget {
		size = { 60 75 }

		block "unique_content_item_specific_bg_frame" {
			icon = {
				parentanchor = center
				size = { 100% 100% }
				texture = "gfx/interface/component_tiles/lobby/lobby_background.dds" 
				texture_density = 2
				spriteType = corneredstretched
				spriteBorder = { 40 40 }
			}	
		}

		# SQUARE ICONS
		widget = {
			visible = "[Or(Or(Or7(
			UniqueContentItem.IsAdvanceDefinition,
			UniqueContentItem.IsLaw,
			UniqueContentItem.IsBuildingType,
			UniqueContentItem.IsCountryInteraction,
			UniqueContentItem.IsCabinetAction,
			UniqueContentItem.IsDisasterType,
			UniqueContentItem.IsSituation),
			Or7(
			UniqueContentItem.IsBureaucracyType,
			UniqueContentItem.IsCharacterInteraction,
			UniqueContentItem.IsFormableCountry,
			UniqueContentItem.IsGenericAction,
			UniqueContentItem.IsHeirSelection,
			UniqueContentItem.IsPolicy,
			UniqueContentItem.IsSocietalValueType)),
			Or(Or(UniqueContentItem.IsSubjectType,
			UniqueContentItem.IsTownRightsType),
			Or(UniqueContentItem.IsReligiousAspect,
			UniqueContentItem.IsOmen)))]"

			block "unique_content_item_specific_bg" {}

			size = "[PdxGuiWidget.KeepRatioFromWidthPercent('(float)1.0', '(float)1.0')]"
			position = { 0 9% }

			widget = {
				ignore_layout = yes
				size = { 64 64 }
				parentanchor = center
				background = {
					texture = "gfx/interface/buttons/flats/flat_bg_button.dds"
					texture_density = 2
					margin = {-4 -4}
					modify_texture = {using = color_dark_brown_texture}
					alpha = 0.7
				}
				background = {
					texture = "gfx/interface/component_tiles/lobby/country_lobby_flavor_frame_round.dds"
					texture_density = 2
				}
			}

			# ADVANCE
			icon = {
				visible = "[UniqueContentItem.IsAdvanceDefinition]"
				datacontext = "[UniqueContentItem.GetAdvanceDefinition]"
				block "country_culture_datacontext" {}

				parentanchor = center
				size = { 70% 70% }
				
				widget = {
					parentanchor = center
					size = { 100% 100% }
					visible = "[Not(AdvanceDefinition.HasSubunitUnlocks)]"
					datacontext = "[GetPlayer]"
					using = advance_icon_base
				}

				# Unit illustrations need a smaller scale than flat icons to avoid bleeding past the card frame
				widget = {
					parentanchor = center
					size = { 85% 85% }
					visible = "[AdvanceDefinition.HasSubunitUnlocks]"
					datacontext = "[GetPlayer]"
					using = advance_icon_base
				}
			}

			# LAW
			icon = {
				visible = "[UniqueContentItem.IsLaw]"
				parentanchor = center
				size = { 62% 62% }
				texture = "[GetLawIcon(UniqueContentItem.GetLaw)]"
			}

			# BUILDING
			icon = {
				visible = "[UniqueContentItem.IsBuildingType]"
				parentanchor = center
				size = { 50% 50% }
				texture = "[GetBuildingIcon(UniqueContentItem.GetBuildingType)]"
			}

			# COUNTRY INTERACTIONS
			icon = {
				visible = "[UniqueContentItem.IsCountryInteraction]"
				parentanchor = center
				size = { 62% 62% }
				texture = "gfx/interface/icons/flat_icons/tabicons/diplomacy.dds"
			}

			# CABINET ACTION
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsCabinetAction]"
				
				cabinet_action_power = {
					datacontext = "[UniqueContentItem.GetCabinetAction]"
					parentanchor = center
					size = { 66% 66% }
					texture = "[GetCabinetActionIcon(CabinetAction.Self)]"
				}
			}

			# DISASTER
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsDisasterType]"
				
				icon = {
					datacontext = "[UniqueContentItem.GetDisasterType]"
					parentanchor = center
					size = { 100% 100% }
					texture = "[DisasterType.GetIcon]"
				}
			}

			# SITUATION
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsSituation]"
				
				icon = {
					datacontext = "[UniqueContentItem.GetSituation]"
					parentanchor = center
					size = { 75% 75% }
					texture = "[Situation.GetIcon]"
				}
			}

			# BUREAUCRACY TYPE
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsBureaucracyType]"

				icon = {
					parentanchor = center
					size = { 100% 100% }
					datacontext = "[UniqueContentItem.GetBureaucracyType]"
					texture = "[GetBureaucracyIcon(BureaucracyType.Self)]"
				}
			}

			# CHARACTER INTERACTION
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsCharacterInteraction]"

				icon = {
					parentanchor = center
					size = { 100% 100% }
					datacontext = "[UniqueContentItem.GetCharacterInteraction]"
					texture = "[CharacterInteraction.GetIcon]"
				}
			}

			# FORMABLE COUNTRY
			widget = {
				parentanchor = center
				size = { 80% 80% }
				visible = "[UniqueContentItem.IsFormableCountry]"

				country_flag = {
					datacontext = "[UniqueContentItem.GetFormableCountry]"
					size = { 100% 66% }
					parentanchor = center
					
					blockoverride "tooltip" {
						tooltip_enabled = no
						tagtooltip_enabled = no
					}
					
					blockoverride "contextmenu" {
						contextmenu_enabled = no
					}
					
					blockoverride "flag" {
						datacontext = "[FormableCountry.GetOrCreateCoatOfArms(Player.Self)]"
						texture = "[CoatOfArmsWrapper.GetTexture('(int32)144','(int32)96')]"
						frame = "[CoatOfArmsWrapper.GetFrame('(int32)144','(int32)96')]"
						framesize = "[CoatOfArmsWrapper.GetFrameSizeOrFallback('(int32)144','(int32)96','(float)0.5')]"
						texture_density = 2
					}
	
					blockoverride "click" {}
					blockoverride "double_click" {}
					blockoverride "hover" {}
				}
			}

			# GENERIC ACTION
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsGenericAction]"

				icon = {
					parentanchor = center
					size = { 100% 100% }
					datacontext = "[UniqueContentItem.GetGenericAction]"
					texture = "[GenericAction.GetIcon]"
				}
			}

			# HEIR SELECTION
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsHeirSelection]"

				icon = {
					parentanchor = center
					size = { 75% 75% }
					texture = "[GetConceptTexture('heir_selection')]"
				}
			}

			# POLICY
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsPolicy]"

				icon = {
					parentanchor = center
					size = { 100% 100% }
					datacontext = "[UniqueContentItem.GetPolicy]"
					texture = "[GetLawIcon(Policy.GetLaw)]"
				}
			}

			# SOCIETAL VALUE TYPE
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsSocietalValueType]"

				icon = {
					parentanchor = center
					size = { 100% 100% }
					texture = "[GetConceptTexture('societal_value')]"
				}
			}

			# SUBJECT TYPE
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsSubjectType]"

				icon = {
					parentanchor = center
