template unique_content_type_category_tooltip_template {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[GetConceptTexture_StringView(UniqueContentTypeCategory.GetConceptKey)]"
			}
		}

		blockoverride "title_text" {
			text = "CONTENT"
		}
		
		blockoverride "concept_link" {
			raw_text = "[UniqueContentTypeCategory.GetConcept.GetName|e]"
		}

		blockoverride "tooltip_content" {
			TooltipScrolledContentSection = {
				blockoverride "section_content" {
					margin_right = 10
					datamodel = "[UniqueContentTypeCategory.GetItems]"
					item = {
						unique_content_item = {}
					}
				}
			}
		}
	}
}


template unique_content_item_header_bg {
	using = bg_card_header_01_advances
	blockoverride "header_advances_extra" {
		visible = "[UniqueContentItem.IsAdvanceDefinition]"
	}

	using = bg_card_header_01_government
	blockoverride "header_government_extra" {
		visible = "[Or5(
		UniqueContentItem.IsSituation, 
		UniqueContentItem.IsGovernmentReform,
		UniqueContentItem.IsEstatePrivilege,
		UniqueContentItem.IsLaw,
		UniqueContentItem.IsCabinetAction)]"
	}

	using = bg_card_header_01_military
	blockoverride "header_military_extra" {
		visible = "[Or(UniqueContentItem.IsLevySetup, UniqueContentItem.IsSubUnitDef)]"
	}

	using = bg_card_header_01_production
	blockoverride "header_production_extra" {
		visible = "[UniqueContentItem.IsBuildingType]"
	}

	using = bg_card_header_01_diplomacy
	blockoverride "header_diplomacy_extra" {
		visible = "[Or(Or3(Or5(
		UniqueContentItem.IsCountryInteraction,
		UniqueContentItem.IsBureaucracyType,
		UniqueContentItem.IsCharacterInteraction,
		UniqueContentItem.IsFormableCountry,
		UniqueContentItem.IsGenericAction),
		Or5(
		UniqueContentItem.IsHeirSelection,
		UniqueContentItem.IsPolicy,
		UniqueContentItem.IsSocietalValueType,
		UniqueContentItem.IsSubjectType,
		UniqueContentItem.IsTownRightsType),
		UniqueContentItem.IsReligiousAspect),
		UniqueContentItem.IsOmen)]"
	}

	using = bg_card_header_01_hre
	blockoverride "bg_header_diplomacy_extra" {
		visible = "[UniqueContentItem.IsDisasterType]"
	}

	blockoverride "graphical_culture_pattern_texture" {
		texture = "[GetGraphicalCultureTexture('header_pattern')]"
	}
}


template unit_type_illustration_playable {
	tooltipwidget = {
		using = SubUnitType_tooltip
	}

	masked_threecolor_icon = {
		visible = "[Not(SubUnitType.GetCategory.IsArmy)]"
		texture = "[GetSubunitTypeIllustration(SubUnitType.Self, Country.GetCulture)]"
		size = { 100% 100% }
		texture_density = 2
		spriteborder = { 0 0 }
		frame_grid = {3 1}
		frame = 2
		mask =  "[GetSubunitTypeIllustrationMask(SubUnitType.Self, Country.GetCulture)]"
		primary_color = "[GetCountryUnitPrimaryColor(Country.GetCountryRef, SubUnitType.Self)]"
		secondary_color = "[GetCountryUnitSecondaryColor(Country.GetCountryRef, SubUnitType.Self)]"
		tertiary_color = "[GetCountryUnitTertiaryColor(Country.GetCountryRef, SubUnitType.Self)]"
	}
	masked_threecolor_icon = {
		visible = "[SubUnitType.GetCategory.IsArmy]"
		texture = "[GetSubunitTypeIllustration(SubUnitType.Self, Country.GetCulture)]"
		size = { 100% 100% }
		texture_density = 2
		spriteborder = { 0 0 }
		frame_grid = {3 1}
		frame = 1
		mask =  "[GetSubunitTypeIllustrationMask(SubUnitType.Self, Country.GetCulture)]"
		primary_color = "[GetCountryUnitPrimaryColor(Country.GetCountryRef, SubUnitType.Self)]"
		secondary_color = "[GetCountryUnitSecondaryColor(Country.GetCountryRef, SubUnitType.Self)]"
		tertiary_color = "[GetCountryUnitTertiaryColor(Country.GetCountryRef, SubUnitType.Self)]"
	}
	icon = {
		parentanchor = center
		ignore_layout = yes
		size = {100% 100%}
		texture = "gfx/interface/component_masks/mask_events_texture_full.dds"
		spriteType = corneredstretched
		spriteborder = {60 60}
		texture_density = 2
		alpha = 0.6
		modify_texture = {
			using = color_dark_brown_texture
		}
	}
}


