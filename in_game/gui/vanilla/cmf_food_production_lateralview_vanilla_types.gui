						texture = "[GetConceptTexture('building')]"
						size = {15 15}
					}
					datacontext = "[FoodLocationItem.GetLocation]"
							
					action_tooltip = {
						click_modifier = default
						enabled = "[FoodLocationItem.CanProduceFoodBuildings]"
						click_mode = single
