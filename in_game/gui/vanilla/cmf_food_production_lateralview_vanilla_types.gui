							on_action = "[PdxGuiTriggerAllAnimations('reset_carousel')]"
						}

						text_single = {
							visible = "[Not(GreaterThan_int32(Location.GetMaxRGOWorkersUnderConstruction,'(int32)0'))]"
							margin_right = 7
							margin_bottom = 1
							parentanchor = right|vcenter
