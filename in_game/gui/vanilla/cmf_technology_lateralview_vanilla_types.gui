						using = color_bg_blue_texture
						blend_mode = multiply
					}
				}
				background = {
					texture = "gfx/interface/component_tiles/hud_corners/circle_frame.dds"
					texture_density = 2
					alpha = 1
					using = color_gold
					using = overlay_gold
				}
				piechart = {
					parentanchor = center
					size = { 100% 100% }
