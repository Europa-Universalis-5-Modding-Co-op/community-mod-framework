							texture_density = 2
							alpha = 1
						}
					}
					lowpriotextcontext =  "[AdvanceNode.GetItem.GetUnlockInformation]"
				}
			}
		}

		# country_flag_very_small = {
		# 	parentanchor = center
		# 	visible = "[AdvanceNode.GetItem.IsCountryUnlock]"
		# 	datacontext = "[Player]"
		# 	position = {1 0}

		# 	blockoverride "show_as_button" { visible = no }
