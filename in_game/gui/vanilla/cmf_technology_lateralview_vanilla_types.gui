					using = piechart_angles
					pieslice = {
						texture = "gfx/interface/pie_charts/pie_chart_blue_progress.dds"
						value = "[Player.GetInstitutionSpreadValue(InstitutionItem.GetInstitution.Self)]"
						color = { 1 1 1 1 }
					}
					pieslice = {
