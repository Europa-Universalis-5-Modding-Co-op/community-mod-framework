types CMMModListTypes
{
	# Left mod-list pane with search input and mod rows.
	# Reads:
	# - Player.MakeScope.GetList('cmm_registered_mod_ids') [list<flag>]: registered mod ids for row datamodel.
	# - GetVariableSystem.Get('cmm_mod_search_text') [string]: current search text used by row filtering.
	# - GetVariableSystem.Get('cmm_selected_mod') [string]: currently selected mod key for row state.
	# Writes:
	# - GetVariableSystem.Set('cmm_mod_search_text') [string]: updates search text from the editbox.
	# - GetVariableSystem.Set('cmm_selected_mod') [string]: selects a mod when a row is clicked.
	# - GetVariableSystem.Set('cmm_selected_tab') [string]: sets selected tab to the mod default on row click.
	type cmm_mod_list_panel = vbox {
		name = "cmm_mod_list_panel"
		min_width = 340
		max_width = 340
		layoutpolicy_vertical = expanding
		using = bg_main_inner_alt
		margin = { 12 0 }

		vbox = {
			using = bg_secondary_section
			using = layoutpolicy_expanding

			# Searchbox
			hbox = {
				layoutpolicy_horizontal = expanding
				margin = { 6 6 }
				# using = bg_text_mask_container_dark_blue

				hbox = {
					layoutpolicy_horizontal = expanding
					margin = { 8 0 }

					minimumsize = { 306 30 }
					maximumsize = { 306 30 }

					using = editbox_background
					using = searchbar_icon

					editbox = {
						name = "cmm_mod_search_editbox"

						using = layoutpolicy_expanding

						margin = { 12 0 }
						align = nobaseline

						filter_mouse = none
						alwaystransparent = no
						focuspolicy = all

						default_format = "#high"
						tooltip = "[GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self)]"

						ontextchanged = "[GetVariableSystem.Set('cmm_mod_search_text', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"
						ontextedited = "[GetVariableSystem.Set('cmm_mod_search_text', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"

						text_single = {
							visible = "[IsSelfOrAnyChildAnEmptyEditbox(PdxGuiWidget.AccessParent.Self)]"
							size = { 100% 100% }
							margin = { 12 0 }
							parentanchor = vcenter
							autoresize = no
							alpha = 0.5
							alwaystransparent = yes
							align = left|nobaseline
							text = "CMM_MOD_SEARCH_PLACEHOLDER"
						}
						ui_direction_button = {
							visible = "[Not(IsSelfOrAnyChildAnEmptyEditbox(PdxGuiWidget.AccessParent.Self))]"
							parentanchor = right
							position = { 0 4 }
							size = { 22 22 }

							blockoverride "button_texture"  {
								texture = "gfx/interface/buttons/flats/clean_text.dds"
							}
							action_tooltip = {
								title = "SEARCHBAR_CLEAR_TEXT"
								on_action = "[PdxClearEditBoxText(PdxGuiWidget.AccessParent.AccessParent.FindChild('cmm_mod_search_editbox'))]"
							}
							tooltipwidget = { BasicFunctionalTooltip = {} }
						}

					}
				}
			}

			scrollbox = {
				using = layoutpolicy_expanding
				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding
				minimumsize = { 0 420 }

				blockoverride "scrollbox_content" {
					cmm_mod_list_rows = {}
				}
				window_bottom_paper_template = { }
			}

		}

		# Reset to Defaults
		hbox = {
			visible = "[CMMHasRegisteredMods]"
			layoutpolicy_horizontal = expanding
			margin = { 8 8 }
			spacing = 2
			button_regular = {
				layoutpolicy_horizontal = expanding
				onclick = "[CMMExecuteGui('CMM_ResetToDefaults')]"
				onclick = "[GetVariableSystem.Clear('cmm_window_open')]"
				onclick = "[PdxGuiTriggerAllAnimations('cmm_reopen_window')]"
				text = "CMM_RESET_ALL_TO_DEFAULTS"
				tooltip = "CMM_RESET_ALL_TO_DEFAULTS_TOOLTIP"
			}
			button_regular = {
				layoutpolicy_horizontal = expanding
				enabled = "[CMMSelectedModExists]"
				onclick = "[CMMExecuteGuiWithSelectedMod('CMM_ResetModToDefaults')]"
				onclick = "[GetVariableSystem.Clear('cmm_window_open')]"
				onclick = "[PdxGuiTriggerAllAnimations('cmm_reopen_window')]"
				text = "CMM_RESET_MOD_TO_DEFAULTS"
				tooltip = "CMM_RESET_MOD_TO_DEFAULTS_TOOLTIP"
			}
		}
	}

	# Datamodel-backed mod row list container.
	# Reads:
	# - Player.MakeScope.GetList('cmm_registered_mod_ids') [list<flag>]: mod ids rendered as rows.
	# - Scope.GetFlagName [string]: current row mod id.
	type cmm_mod_list_rows = vbox {
		using = layoutpolicy_expanding
		margin = { 6 6 }

		vbox = {
			layoutpolicy_horizontal = expanding
			ignoreinvisible = yes
			spacing = 4
			datamodel = "[Player.MakeScope.GetList('cmm_registered_mod_ids')]"

			item = {
				cmm_mod_list_row = {}
			}
		}

		expand = {}
	}

	# Single mod row with select behavior.
	# Reads:
	# - Scope.GetFlagName [string]: current row mod id.
	# - GetVariableSystem.Get('cmm_mod_search_text') [string]: free-text filter for row visibility.
	# - GetVariableSystem.Get('cmm_selected_mod') [string]: selected mod id for button down-state.
	# - Player.MakeScope.GetVariable(Concatenate(Scope.GetFlagName, '_desc')) [flag]: localized mod description used by hover tooltips.
	# Writes:
	# - GetVariableSystem.Set('cmm_selected_mod') [string]: selects this row's mod id.
	# - GetVariableSystem.Set('cmm_selected_tab') [string]: sets selected tab to the mod default.
	type cmm_mod_list_row = widget {
		layoutpolicy_horizontal = expanding
		minimumsize = { 0 44 }
		visible = "[And(CMMCachedModMatchesSearch(Scope.GetFlagName), CMMModNonEmpty(Scope.GetFlagName))]"

		state = {
			name = cmm_cache_mod_row
			trigger_on_create = yes
			on_start = "[GetVariableSystem.Set(Concatenate(Scope.GetFlagName, '_mrn'), CMMLocalizedSuffix(Scope.GetFlagName, '_name'))]"
			on_start = "[GetVariableSystem.Set(Concatenate(Scope.GetFlagName, '_mrd'), CMMLocalizedSuffixText(Scope.GetFlagName, '_desc'))]"
			on_start = "[GetVariableSystem.Set(Concatenate(Scope.GetFlagName, '_mrhd'), Select_CString(CMMHasLocalizedSuffixText(Scope.GetFlagName, '_desc'), 'yes', 'no'))]"
		}

		hbox = {
			margin = { 2 2 }

			card_header_button_01 = {
				using = layoutpolicy_expanding
				size = { -1 40 }
				using = bg_paper_card
				using = bg_card_header_01_production
				onclick = "[GetVariableSystem.Set('cmm_selected_mod', Scope.GetFlagName)]"
				onclick = "[GetVariableSystem.Set('cmm_selected_tab', CMMMetadataFlag('cmm_mod_default_tab_', Scope.GetFlagName))]"
				onclick = "[CMMExecuteGui('CMF_CloseLogView')]"
				down = "[GetVariableSystem.HasValue('cmm_selected_mod', Scope.GetFlagName)]"
				tagtooltip_enabled = yes
				tooltip = "[CMMCachedModDesc(Scope.GetFlagName)]"
				tooltip_enabled = "[CMMCachedModHasDesc(Scope.GetFlagName)]"
				tooltipwidget = { BasicFunctionalTooltip = {} }

				blockoverride "card_color" {
					modify_texture = {
						visible = "[GetVariableSystem.HasValue('cmm_selected_mod', Scope.GetFlagName)]"
						using = color_gold_texture
						alpha = 0.16
					}
				}

				widget = {
					size = { 100% 100% }

					text_single = {
						parentanchor = center
						autoresize = yes
						fontsize = 18
						maximumsize = { 280 -1 }
						align = center|nobaseline
						text = "[CMMCachedModName(Scope.GetFlagName)]"
					}
				}
			}
		}
	}
}
