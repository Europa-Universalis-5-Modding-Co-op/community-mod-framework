types CMMSettingsTypes
{
	# Right settings pane for the currently selected mod.
	# Reads:
	# - CMMHomeScope.GetList('cmm_registered_tab_keys') [list<flag>]: registered tab keys for tab and sub-tab rendering.
	# - CMMHomeScope.GetList('cmm_registered_group_keys') [list<flag>]: registered group keys for group rendering.
	# - GetVariableSystem.Get('cmm_selected_mod') [string]: active mod id for tab and row filtering.
	# - GetVariableSystem.Get('cmm_selected_tab') [string]: active tab key for tab and row filtering.
	# - CMMHomeScope.GetVariableFromVariableMap('cmm_tab_default_child', ...) [flag]: whether the sub-tab row and its divider show.
	# Writes:
	# - GetVariableSystem.Set('cmm_selected_tab') [string]: changes selected tab from tab clicks.
	# - <mod_id>__<setting_id> callbacks [effect]: update setting values when controls are used.
	type cmm_settings_panel = vbox {
		using = layoutpolicy_expanding

		cmm_mod_tabs = {}

		vbox = {
			using = layoutpolicy_expanding
			using = bg_main_inner_alt
			ignoreinvisible = yes
			margin = { 12 12 }
			spacing = 10

			cmm_mod_subtabs = {}

			text_multi = {
				visible = "[CMMNoModsRegistered]"
				text = "CMM_NO_MODS_REGISTERED"
				autoresize = yes
				max_width = 680
			}

			vbox = {
				visible = "[CMMHasRegisteredMods]"
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				scrollbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					minimumsize = { 0 420 }

					blockoverride "scrollbox_content" {
						cmm_setting_groups = {}
					}
				}

				text_multi = {
					visible = "[CMMShowNoSettingsForSelectedTab]"
					text = "CMM_NO_SETTINGS_FOR_TAB"
					autoresize = yes
					max_width = 680
				}

				expand = {}
			}
		}

	}

	# Top-level tab bar for the selected mod.
	# Reads:
	# - Scope.GetFlagName [string]: current tab key (`<mod_id>__<tab_id>`) from tab datamodel.
	# - CMMHomeScope.GetList('cmm_registered_tab_keys') [list<flag>]: tab key source list.
	# - GetVariableSystem.Get('cmm_selected_mod') [string]: selected mod id used for owner filtering.
	# - GetVariableSystem.Get('cmm_selected_tab') [string]: selected tab key used for down-state.
	# - CMMHomeScope.GetVariableFromVariableMap('cmm_tab_parent', ...) [flag]: filters sub-tabs out of this row.
	# - CMMHomeScope.GetVariableFromVariableMap('cmm_tab_default_child', ...) [flag]: click target for a tab with sub-tabs.
	# - GetVariableSystem.Get('<mod_id>__<tab_id>_lsub') [string]: sub-tab a tab with sub-tabs reopens on.
	# Writes:
	# - GetVariableSystem.Set('cmm_selected_tab') [string]: selects clicked tab.
	type cmm_mod_tabs = header_main_tabs {
		visible = "[CMMSelectedModExists]"

		blockoverride "content" {
			datamodel = "[CMMHomeScope.GetList('cmm_registered_tab_keys')]"
			datamodel_reuse_widgets = yes

			item = {
				button_main_tab_alt = {
					using = layoutpolicy_expanding
					size = { -1 40 }
					visible = "[And3(CMMSelectedHasValue('cmm_selected_mod', CMMMetadataFlag('cmm_tab_owner_mod_id_', Scope.GetFlagName)), Not(CMMTabHasParent(Scope.GetFlagName)), CMMTabNonEmpty(Scope.GetFlagName))]"
					onclick = "[GetVariableSystem.Set('cmm_selected_tab', CMMTabLeaf(Scope.GetFlagName))]"
					down = "[EqualTo_string(CMMSelectedTopTab, Scope.GetFlagName)]"
					tooltip_enabled = no

					hbox = {
						margin = { 5 0 }
						margin_top = 4
						text_single = {
							text = "[CMMLocalizedSuffix(Scope.GetFlagName, '_name')]"
							using = Font_Type_Headers
							using = layoutpolicy_expanding
							align = center
							autoresize = no
						}
					}
				}
			}
		}
	}

	# Sub-tab row for the selected top-level tab, carrying the main tab bar's blue backing.
	# Reads:
	# - Scope.GetFlagName [string]: current tab key (`<mod_id>__<tab_id>`) from tab datamodel.
	# - CMMHomeScope.GetList('cmm_registered_tab_keys') [list<flag>]: tab key source list.
	# - GetVariableSystem.Get('cmm_selected_tab') [string]: selected tab key used for down-state.
	# - CMMHomeScope.GetVariableFromVariableMap('cmm_tab_parent', ...) [flag]: filters this row to the selected tab's siblings.
	# - CMMHomeScope.GetVariableFromVariableMap('cmm_tab_default_child', ...) [flag]: whether the selected top-level tab has sub-tabs at all.
	# Writes:
	# - GetVariableSystem.Set('cmm_selected_tab') [string]: selects clicked sub-tab.
	# - GetVariableSystem.Set('<mod_id>__<parent_tab_id>_lsub') [string]: records the clicked sub-tab as the parent's open sub-tab.
	type cmm_mod_subtabs = hbox {
		visible = "[CMMSubTabRowShown]"
		layoutpolicy_horizontal = expanding
		size = { -1 35 }
		margin_left = 3
		margin_right = 3
		margin_top = 2
		spacing = 5

		background = {
			using = color_dark_blue_texture
		}

		background = {
			using = bg_fade_vertical_up_mask_texture
			alpha = 0.3

			modify_texture = {
				using = color_black_texture
				blend_mode = multiply
			}
		}

		datamodel = "[CMMHomeScope.GetList('cmm_registered_tab_keys')]"
		datamodel_reuse_widgets = yes

		item = {
			button_main_tab_alt = {
				using = layoutpolicy_expanding
				size = { -1 33 }
				visible = "[And(EqualTo_string(CMMTabParent(Scope.GetFlagName), CMMSelectedTopTab), CMMTabNonEmpty(Scope.GetFlagName))]"
				onclick = "[GetVariableSystem.Set('cmm_selected_tab', Scope.GetFlagName)]"
				onclick = "[GetVariableSystem.Set(Concatenate(CMMTabParent(Scope.GetFlagName), '_lsub'), Scope.GetFlagName)]"
				down = "[GetVariableSystem.HasValue('cmm_selected_tab', Scope.GetFlagName)]"
				tooltip_enabled = no

				hbox = {
					margin = { 5 0 }
					margin_top = 4
					text_single = {
						text = "[CMMLocalizedSuffix(Scope.GetFlagName, '_name')]"
						using = Font_Type_Headers
						using = layoutpolicy_expanding
						fontsize = 16
						align = center
						autoresize = no
					}
				}
			}
		}
	}

	# Datamodel-backed group container.
	# Reads:
	# - CMMHomeScope.GetList('cmm_registered_group_keys') [list<flag>]: group keys rendered as group sections.
	# - Scope.GetFlagName [string]: current group key (`<mod_id>__<tab_id>__<group_id>`).
	type cmm_setting_groups = vbox {
		layoutpolicy_horizontal = expanding
		ignoreinvisible = yes
		spacing = 8
		margin_left = 6
		margin_right = 14
		datamodel = "[CMMHomeScope.GetList('cmm_registered_group_keys')]"

		item = {
			cmm_setting_group = {}
		}
	}

	# Single setting group with a collapsible header and per-group setting rows.
	# Reads:
	# - Scope.GetFlagName [string]: current group key (`<mod_id>__<tab_id>__<group_id>`).
	# - CMMHomeScope.GetList(Concatenate('cmm_group_setting_keys_', Scope.GetFlagName)) [list<flag>]: settings in this group.
	# - CMMHomeScope.GetVariableFromVariableMap('cmm_group_collapsed', ...) [value]: collapsed state of this group.
	# - CMMHomeScope.GetVariableFromVariableMap('cmm_group_visible_count', ...) [value]: visible setting count shown in the header.
	# Writes:
	# - GetScriptedGui('CMM_ToggleGroupCollapsed').Execute(...) [effect]: flips this group's collapsed state.
	type cmm_setting_group = vbox {
		layoutpolicy_horizontal = expanding
		visible = "[And(CMMCachedGroupRowVisible(Scope.GetFlagName), CMMGroupNonEmpty(Scope.GetFlagName))]"

		state = {
			name = cmm_cache_group_row
			trigger_on_create = yes
			on_start = "[GetVariableSystem.Set(Concatenate(Scope.GetFlagName, '_grom'), CMMMetadataFlag('cmm_group_owner_mod_id_', Scope.GetFlagName))]"
			on_start = "[GetVariableSystem.Set(Concatenate(Scope.GetFlagName, '_grot'), CMMMetadataFlag('cmm_group_owner_tab_key_', Scope.GetFlagName))]"
			on_start = "[GetVariableSystem.Set(Concatenate(Scope.GetFlagName, '_grn'), CMMLocalizedSuffix(Scope.GetFlagName, '_name'))]"
			on_start = "[GetVariableSystem.Set(Concatenate(Scope.GetFlagName, '_grd'), CMMLocalizedSuffixText(Scope.GetFlagName, '_desc'))]"
		}

		icon = {
			layoutpolicy_horizontal = expanding
			size = { 0 40 }
			using = button_main_tab_texture
			frame = 4

			modify_texture = {
				using = color_intense_bg_blue_texture
				blend_mode = multiply
			}

			modify_texture = {
				using = overlay_leather_texture
				blend_mode = overlay
				alpha = 0.2
			}

			hbox = {
				size = { 100% 100% }
				margin_left = 20
				margin_right = 14
				margin_top = 10
				spacing = 8

				text_single = {
					layoutpolicy_horizontal = expanding
					using = button_common_textobj_font
					fontsize = 18
					autoresize = no
					default_format = "#yellow_titles"
					text = "[CMMCachedGroupName(Scope.GetFlagName)]"
				}

				text_single = {
					autoresize = yes
					using = button_common_textobj_font
					fontsize = 16
					default_format = "#yellow_titles"
					text = "[CMMGroupVisibleCountText(Scope.GetFlagName)]"
				}

				widget = {
					size = { 20 20 }

					icon = {
						parentanchor = center
						visible = "[CMMGroupCollapsed(Scope.GetFlagName)]"
						size = { 16 16 }
						texture = "gfx/interface/buttons/flats/button_simple_right.dds"
						using = color_gold
					}

					icon = {
						parentanchor = center
						visible = "[CMMGroupExpanded(Scope.GetFlagName)]"
						size = { 16 16 }
						position = { 0 2 }
						texture = "gfx/interface/buttons/flats/button_simple_down.dds"
						using = color_gold
					}
				}
			}

			button = {
				size = { 100% 100% }
				tagtooltip_enabled = yes
				tooltip = "[CMMCachedGroupDesc(Scope.GetFlagName)]"
				tooltipwidget = { BasicFunctionalTooltip = {} }

				action_tooltip = {
					title = "CMM_GROUP_TOGGLE_COLLAPSE"
					on_action = "[CMMToggleGroupCollapsed(Scope.GetFlagName)]"
				}

				action_tooltip = {
					click_type = right
					title = "CMM_GROUP_TOGGLE_COLLAPSE_ALL"
					on_action = "[CMMToggleTabGroupsCollapsed(Scope.GetFlagName)]"
				}
			}
		}

		vbox = {
			using = bg_secondary_section
			layoutpolicy_horizontal = expanding
			margin = { 12 12 }
			spacing = 4
			visible = "[CMMGroupExpanded(Scope.GetFlagName)]"

			datamodel = "[CMMHomeScope.GetList(Concatenate('cmm_group_setting_keys_', Scope.GetFlagName))]"

			item = {
				cmm_setting_row = {}
			}
		}
	}
}
