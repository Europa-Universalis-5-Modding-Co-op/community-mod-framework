types CMMLogTypes
{
	# Log pane showing recorded mod actions.
	# Reads:
	# - GetGlobalVariable('cmf_log_count') [value]: entry count for DataModelRepeatedItem.
	# - GetVariableFromGlobalVariableMap('cmf_log_*', MakeScopeFlag(...)) [variable]: per-entry data.
	# Writes:
	# - CMF_ClearLog scripted GUI [effect]: clears all log entries.
	# - ExecuteConsoleCommand(...) [effect]: clears all log entries in observer mode.
	type cmm_log_panel = vbox {
		using = layoutpolicy_expanding

		header_main_tabs = {
			blockoverride "content" {
				button_main_tab_alt = {
					using = layoutpolicy_expanding
					size = { -1 40 }
					down = yes
					tooltip_enabled = no

					hbox = {
						margin = { 5 0 }
						margin_top = 4
						text_single = {
							text = "CMM_LOG_TITLE"
							using = Font_Type_Headers
							using = layoutpolicy_expanding
							align = center
							autoresize = no
						}
					}
				}
			}
		}

		vbox = {
			using = layoutpolicy_expanding
			using = bg_main_inner_alt
			margin = { 12 12 }
			spacing = 10

			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				text_multi = {
					visible = "[Not(CMFLogHasEntries)]"
					text = "CMM_LOG_EMPTY"
					autoresize = yes
					max_width = 680
				}

				scrollbox = {
					visible = "[CMFLogHasEntries]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					minimumsize = { 0 420 }

					blockoverride "scrollbox_content" {
						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 2
							datamodel = "[DataModelRepeatedItem(CMFLogCount)]"

							item = {
								cmm_log_entry_row = {}
							}
						}
					}
				}

				expand = {}
			}

			hbox = {
				visible = "[And(CMFLogHasEntries, CMMGuiIsShown('CMF_ClearLog'))]"
				layoutpolicy_horizontal = expanding
				margin = { 0 4 }
				ignoreinvisible = yes

				expand = {}

				button_regular_diamond = {
					visible = "[Not(IsPlayerObserver)]"
					minimumsize = { 168 32 }
					onclick = "[CMMExecuteGui('CMF_ClearLog')]"
					text = "CMM_LOG_CLEAR"
					tooltip = "CMM_LOG_CLEAR_TOOLTIP"
				}

				# An Execute never reaches script in observer mode. cmf_clear_log touches only globals,
				# so the command needs no country scope and GUI exposes only a display tag anyway.
				button_regular_diamond = {
					visible = "[IsPlayerObserver]"
					minimumsize = { 168 32 }
					onclick = "[ExecuteConsoleCommand('effect cmf_clear_log = yes')]"
					text = "CMM_LOG_CLEAR"
					tooltip = "CMM_LOG_CLEAR_TOOLTIP"
				}

				expand = {}
			}
		}
	}

	# Single log entry row displaying actor country and action text.
	# Reads:
	# - PdxGuiWidget.GetIndexInDataModel [int32]: entry index for flag key construction.
	# - GetVariableFromGlobalVariableMap('cmf_log_*', MakeScopeFlag(Concatenate('cmf_log_', ...))) [variable]: per-entry data.
	type cmm_log_entry_row = hbox {
		layoutpolicy_horizontal = expanding
		minimumsize = { 0 36 }
		using = bg_window_default_alt
		margin = { 8 2 }
		spacing = 8
		ignoreinvisible = yes

		country_flag_small = {
			datacontext = "[CMFLogActorCountry(PdxGuiWidget.GetIndexInDataModel)]"
		}

		text_single = {
			minimumsize = { 120 0 }
			maximumsize = { 120 -1 }
			autoresize = no
			align = left|vcenter
			default_format = "#bold"
			fontsize_min = 11
			text = "[CMFLogActorCountry(PdxGuiWidget.GetIndexInDataModel).GetName]"
		}

		text_single = {
			layoutpolicy_horizontal = expanding
			autoresize = no
			fontsize_min = 11
			align = left|vcenter
			visible = "[And(Not(CMFLogIsAtLocationEntry(PdxGuiWidget.GetIndexInDataModel)), And(Not(CMFLogIsLocationValuesEntry(PdxGuiWidget.GetIndexInDataModel)), And(Not(CMFLogIsBuildingLocationEntry(PdxGuiWidget.GetIndexInDataModel)), And(Not(CMFLogIsLocationEntry(PdxGuiWidget.GetIndexInDataModel)), Not(CMFLogIsDecimalValueEntry(PdxGuiWidget.GetIndexInDataModel))))))]"
			text = "[CMFLogEntryText(PdxGuiWidget.GetIndexInDataModel)]"
		}

		# No decimal in this entry, so it needs none of the fixed columns the rows below use.
		text_single = {
			layoutpolicy_horizontal = expanding
			autoresize = no
			fontsize_min = 11
			align = left|vcenter
			visible = "[CMFLogIsAtLocationEntry(PdxGuiWidget.GetIndexInDataModel)]"
			text = "[CMFLogAtLocationText(PdxGuiWidget.GetIndexInDataModel)]"
		}

		# Every piece of these rows is a fixed column carrying autoresize = no and fontsize_min, the
		# same shape the actor name above uses. An hbox cannot be narrower than the sum of its
		# children's natural widths, so a piece left to size to its own text makes the whole row
		# wider than the pane and the tail of it is cut off. Widest case is the building-location
		# row: 36 flag + 120 actor + 260 + 65 + 85 + 65 with 8 and 5 spacings and the row's 8
		# margins, which comes to 678 inside a pane measured at 772 before its own borders.
		# layoutpolicy_horizontal = expanding on the leading text is what must NOT be used to bound
		# it, since it swallows the row's spare width and strands the numbers at the right edge.
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 5
			visible = "[CMFLogIsDecimalValueEntry(PdxGuiWidget.GetIndexInDataModel)]"

			text_single = {
				minimumsize = { 260 0 }
				maximumsize = { 260 -1 }
				autoresize = no
				fontsize_min = 11
				align = left|vcenter
				text = "[CMFLogAction(PdxGuiWidget.GetIndexInDataModel)]"
			}

			text_single = {
				minimumsize = { 65 0 }
				maximumsize = { 65 -1 }
				autoresize = no
				fontsize_min = 11
				align = left|vcenter
				text = "[CMFLogNumValue(PdxGuiWidget.GetIndexInDataModel)|2]"
			}

			expand = {}
		}

		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 5
			visible = "[CMFLogIsLocationEntry(PdxGuiWidget.GetIndexInDataModel)]"

			text_single = {
				minimumsize = { 260 0 }
				maximumsize = { 260 -1 }
				autoresize = no
				fontsize_min = 11
				align = left|vcenter
				text = "[CMFLogLocationText(PdxGuiWidget.GetIndexInDataModel)]"
			}

			text_single = {
				minimumsize = { 65 0 }
				maximumsize = { 65 -1 }
				autoresize = no
				fontsize_min = 11
				align = left|vcenter
				text = "[CMFLogNumValue(PdxGuiWidget.GetIndexInDataModel)|2]"
			}

			expand = {}
		}

		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 5
			visible = "[CMFLogIsLocationValuesEntry(PdxGuiWidget.GetIndexInDataModel)]"

			text_single = {
				minimumsize = { 260 0 }
				maximumsize = { 260 -1 }
				autoresize = no
				fontsize_min = 11
				align = left|vcenter
				text = "[CMFLogLocationText(PdxGuiWidget.GetIndexInDataModel)]"
			}

			text_single = {
				minimumsize = { 65 0 }
				maximumsize = { 65 -1 }
				autoresize = no
				fontsize_min = 11
				align = left|vcenter
				text = "[CMFLogNumValue(PdxGuiWidget.GetIndexInDataModel)|2]"
			}

			text_single = {
				minimumsize = { 65 0 }
				maximumsize = { 65 -1 }
				autoresize = no
				fontsize_min = 11
				align = left|vcenter
				text = "[CMFLogNum2Value(PdxGuiWidget.GetIndexInDataModel)|2]"
			}

			text_single = {
				minimumsize = { 65 0 }
				maximumsize = { 65 -1 }
				autoresize = no
				fontsize_min = 11
				align = left|vcenter
				text = "[CMFLogNum3Value(PdxGuiWidget.GetIndexInDataModel)|2]"
			}

			expand = {}
		}

		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 5
			visible = "[CMFLogIsBuildingLocationEntry(PdxGuiWidget.GetIndexInDataModel)]"

			text_single = {
				minimumsize = { 260 0 }
				maximumsize = { 260 -1 }
				autoresize = no
				fontsize_min = 11
				align = left|vcenter
				text = "[CMFLogBuildingLocationText(PdxGuiWidget.GetIndexInDataModel)]"
			}

			text_single = {
				minimumsize = { 65 0 }
				maximumsize = { 65 -1 }
				autoresize = no
				fontsize_min = 11
				align = left|vcenter
				text = "[CMFLogNumValue(PdxGuiWidget.GetIndexInDataModel)|2]"
			}

			text_single = {
				minimumsize = { 85 0 }
				maximumsize = { 85 -1 }
				autoresize = no
				fontsize_min = 11
				align = left|vcenter
				text = "[CMFLogArg2Label(PdxGuiWidget.GetIndexInDataModel)]"
			}

			text_single = {
				minimumsize = { 65 0 }
				maximumsize = { 65 -1 }
				autoresize = no
				fontsize_min = 11
				align = left|vcenter
				text = "[CMFLogNum2Value(PdxGuiWidget.GetIndexInDataModel)|2]"
			}

			expand = {}
		}
	}
}
