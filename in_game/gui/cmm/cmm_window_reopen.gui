# Triggered by the reset buttons to re-register and reopen the CMM window so its datamodels rebuild against the reset values.
widget = {
	name = "cmm_window_reopen"
	size = { 0 0 }
	datacontext = "[GetPlayer]"
	visible = "[Country.IsValid]"

	state = {
		name = cmm_reopen_window
		duration = 0.05
		on_finish = "[GetScriptedGui('CMM_RegisterCoreMod').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		on_finish = "[GetVariableSystem.Set('cmm_window_open', '1')]"
		next = cmm_reopen_recache
	}

	# List cells are reused across the window visibility toggle, so their create-time field cache stays stale.
	state = {
		name = cmm_reopen_recache
		duration = 0.05
		on_finish = "[PdxGuiTriggerAllAnimations('cmm_recache_delay')]"
	}
}
