window = {
	name = "cmm_window"
	# This number is not arbitrary. For some reason below 5378 results in much lower performance, while above results in near identical.
	# max_update_rate = 5400
	# reuse_widgets = yes
	# datamodel_reuse_widgets = yes
	alwaystransparent = no
	filter_mouse = all
	layer = top
	reorder_on_mouse = never
	resizable = no
	movable = yes
	parentanchor = center
	widgetanchor = center
	size = { 1140 760 }
	using = bg_window_default_alt
	allow_outside = yes
	visible = "[And(GetVariableSystem.Exists('cmm_window_open'), GetVariableSystem.Exists('cmm_window_ready'))]"

	vbox = {
		using = window_margin_alt
		spacing = 2

		window_header_alt = {
			blockoverride "header_text_object" {
				hbox = {
					visible = "[GetVariableSystem.Exists('cmf_log_view_open')]"

					header_title = {
						text = "CMM_LOG_TITLE"
					}
				}

				hbox = {
					visible = "[And(Not(CMMSelectedModExists), Not(GetVariableSystem.Exists('cmf_log_view_open')))]"

					header_title = {
						text = "CMM_WINDOW_TITLE"
					}
				}

				hbox = {
					visible = "[And(CMMSelectedModExists, Not(GetVariableSystem.Exists('cmf_log_view_open')))]"

					header_title = {
						size = { -1 40 }
						layoutpolicy_horizontal = expanding
						autoresize = no
						maximumsize = { 450 40 }
						tagtooltip_enabled = yes
						tooltip = "[CMMLocalizedSuffixText(GetVariableSystem.Get('cmm_selected_mod'), '_desc')]"
						tooltip_enabled = "[CMMHasLocalizedSuffixText(GetVariableSystem.Get('cmm_selected_mod'), '_desc')]"
						tooltipwidget = { BasicFunctionalTooltip = {} }
						text = "[CMMLocalizedSuffix(GetVariableSystem.Get('cmm_selected_mod'), '_name')]"
					}
				}
			}
		}

		hbox = {
			using = layoutpolicy_expanding
			spacing = 12

			cmm_mod_list_panel = {}
			cmm_settings_panel = {
				visible = "[Not(GetVariableSystem.Exists('cmf_log_view_open'))]"
			}
			cmm_log_panel = {
				visible = "[GetVariableSystem.Exists('cmf_log_view_open')]"
			}
		}
	}

	cmm_window_close_widget = {}
}
