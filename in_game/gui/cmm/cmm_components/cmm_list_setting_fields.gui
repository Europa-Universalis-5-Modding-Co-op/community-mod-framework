	# Ordered list slider field control with compact draggable scrollbar, value display, and dec/inc buttons.
	# Reads:
	# - Scope.GetFlagName [string]: current ordered list item key.
	# - PdxGuiWidget.GetIndexInDataModel [int32]: current field slot index in the parent repeated field datamodel, or overlay slider point index in the track hbox.
	# - Player.MakeScope.GetVariable(Concatenate(Scope.GetFlagName, '_field_<slot>')) [value]: current slider field value for this row item.
	# - Player.MakeScope.GetVariable(Concatenate('cmm_list_field_<slot>_min_', <setting_key>)) [value]: slider minimum bound.
	# - Player.MakeScope.GetVariable(Concatenate('cmm_list_field_<slot>_max_', <setting_key>)) [value]: slider maximum bound.
	# - GetVariableSystem.Get('cmm_list_hover_field_slot') [string]: cached hovered field slot for button click actions and overlay points.
	# Writes:
	# - GetScriptedGui('CMM_MarkListPosition_<index>').Execute(...) [effect]: marks the hovered row position.
	# - GetScriptedGui('CMM_MarkListFieldSlot_<slot>').Execute(...) [effect]: marks the clicked field slot.
	# - GetScriptedGui('CMM_MarkSliderSelection_<index>').Execute(...) [effect]: marks the slider visual index.
	# - GetScriptedGui('CMM_StartSliderDrag').Execute(...) [effect]: begins slider drag tracking.
	# - GetScriptedGui('CMM_StopSliderDrag').Execute(...) [effect]: ends slider drag tracking.
	# - GetScriptedGui('CMM_SliderDragHover_<index>').Execute(...) [effect]: marks slider index during drag.
	# - GetScriptedGui('CMM_MarkNumeric*').Execute(...) [effect]: marks numeric step or min/max mode for dec/inc buttons.
	# - GetScriptedGui('CMM_MarkListFieldSliderAll').Execute(...) [effect]: marks bulk slider apply.
	# - GetScriptedGui(Concatenate(<setting_key>, '_on_changed')).Execute(...) [effect]: applies the queued list change.
	type cmm_list_setting_slider_field = hbox {
		minimumsize = { 198 28 }
		spacing = 0

		widget = {
			size = { 160 28 }
			minimumsize = { 160 28 }
			allow_outside = yes
			onmousehierarchyleave = "[CMMExecuteGui('CMM_StopSliderDrag')]"

			widget = {
				size = { 100% 20 }
				parentanchor = vcenter
				allow_outside = yes

				widget = {
					position = { 20 0 }
					size = { 120 20 }
					minimumsize = { 120 20 }
					allow_outside = yes
					onmousehierarchyleave = "[GetVariableSystem.Clear('cmm_slider_hover_idx')]"
					onmousehierarchyleave = "[GetVariableSystem.Clear('cmm_slider_hover_key')]"

					scrollbar = {
						name = "cmm_list_slider_visual"
						direction = horizontal
						size = { 140 20 }
						position = { -10 0 }
						minimumsize = { -1 14 }
						enabled = "[GetVariableSystem.HasValue('cmm_can_edit_list', 'yes')]"
						min = 0
						max = "[CMMListFieldSliderNormalizedMax(CMMListItemOwnerSettingKey(Scope.GetFlagName), ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))]"
						step = "[CMMListFieldMetadataValue(CMMListItemOwnerSettingKey(Scope.GetFlagName), ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)), '_step_')]"
						wheelstep = 0
						value = "[CMMListFieldSliderNormalizedValue(Scope.GetFlagName, ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))]"

						track = {
							EconomySlider_TrackRange = {
								# Fill right edge follows the thumb center.
								progressbar = {
									size = { 100% 100% }
									noprogresstexture = "gfx/interface/icons/unit_view/moral_bar_transparent.dds"
									progresstexture = "gfx/interface/progressbars/progress_bar_blue_alt.dds"
									texture_density = 2
									spriteType = Corneredstretched
									spriteborder = { 0 0 }
									min = 0
									max = 140
									value = "[FixedPointToFloat(Add_CFixedPoint('(CFixedPoint)10', Multiply_CFixedPoint(Divide_CFixedPoint(CMMListFieldSliderNormalizedValue(Scope.GetFlagName, ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel))), CMMListFieldSliderNormalizedMax(CMMListItemOwnerSettingKey(Scope.GetFlagName), ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))), '(CFixedPoint)120')))]"
								}
							}
						}

						slider = {
							EconomySlider_Slider = {
								size = { 20 20 }

								icon = {
									size = { 100% 100% }
									texture = "gfx/interface/buttons/flats/slider.dds"
									alpha = 0.15
									visible = "[Not(CMMSliderThumbHover(CMMListSliderThumbIndex(Scope.GetFlagName, ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel))), Scope.GetFlagName))]"

									modify_texture = {
										using = color_black_texture
										blend_mode = multiply
									}
								}
							}
						}

						dec_button = { button = {} }
						inc_button = { button = {} }
					}

					hbox = {
						size = { 100% 20 }

						widget = {
							size = { 3 20 }
							minimumsize = { 3 20 }
							allow_outside = yes
							onmousehierarchyenter = "[GetVariableSystem.Set('cmm_slider_hover_key', Scope.GetFlagName)]"
							onmousehierarchyenter = "[GetVariableSystem.Set('cmm_slider_hover_idx', '0')]"
							onmousehierarchyenter = "[CMMExecuteGuiSuffix('CMM_MarkListPosition_', GetVariableSystem.Get('cmm_list_hover_index'))]"
							onmousehierarchyenter = "[CMMExecuteGuiSuffix('CMM_MarkListFieldSlot_', GetVariableSystem.Get('cmm_list_hover_field_slot'))]"
							onmousehierarchyenter = "[CMMExecuteGui('CMM_SliderDragHover_0')]"
							onmousehierarchyenter = "[CMMExecuteListItemSettingChanged(Scope.GetFlagName)]"
							onmousehierarchyenter = "[PdxGuiTriggerAllAnimations('cmm_recache_delay')]"

							button = {
								size = { 100% 20 }
								alpha = 0
								effectname = "NoHighlight"
								onpressed = "[CMMExecuteGui('CMM_StartSliderDrag')]"
								onpressed = "[CMMExecuteGuiSuffix('CMM_MarkListPosition_', GetVariableSystem.Get('cmm_list_hover_index'))]"
								onpressed = "[CMMExecuteGuiSuffix('CMM_MarkListFieldSlot_', GetVariableSystem.Get('cmm_list_hover_field_slot'))]"
								onpressed = "[CMMExecuteGui('CMM_MarkSliderSelection_0')]"
								onpressed = "[CMMExecuteListItemSettingChanged(Scope.GetFlagName)]"
								onpressed = "[PdxGuiTriggerAllAnimations('cmm_recache_delay')]"
								onreleased = "[CMMExecuteGui('CMM_StopSliderDrag')]"
								tooltip_enabled = no
							}
						}

						widget = {
							size = { 114 20 }
							minimumsize = { 114 20 }

							hbox = {
								size = { 100% 20 }
								datamodel = "[DataModelRepeatedItem('(int32)19')]"
								datamodel_reuse_widgets = yes

								item = {
									widget = {
										layoutpolicy_horizontal = expanding
										size = { 0 20 }
										allow_outside = yes
										onmousehierarchyenter = "[GetVariableSystem.Set('cmm_slider_hover_key', Scope.GetFlagName)]"
										onmousehierarchyenter = "[GetVariableSystem.Set('cmm_slider_hover_idx', ToString_int32(Multiply_int32(Add_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)1'), '(int32)5')))]"
										onmousehierarchyenter = "[CMMExecuteGuiSuffix('CMM_MarkListPosition_', GetVariableSystem.Get('cmm_list_hover_index'))]"
										onmousehierarchyenter = "[CMMExecuteGuiSuffix('CMM_MarkListFieldSlot_', GetVariableSystem.Get('cmm_list_hover_field_slot'))]"
										onmousehierarchyenter = "[CMMExecuteGuiSuffix('CMM_SliderDragHover_', ToString_int32(Multiply_int32(Add_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)1'), '(int32)5')))]"
										onmousehierarchyenter = "[CMMExecuteListItemSettingChanged(Scope.GetFlagName)]"
										onmousehierarchyenter = "[PdxGuiTriggerAllAnimations('cmm_recache_delay')]"

										button = {
											size = { 100% 20 }
											alpha = 0
											effectname = "NoHighlight"
											onpressed = "[CMMExecuteGui('CMM_StartSliderDrag')]"
											onreleased = "[CMMExecuteGui('CMM_StopSliderDrag')]"
											onrightclick = "[CMMExecuteGuiSuffix('CMM_MarkListPosition_', GetVariableSystem.Get('cmm_list_hover_index'))]"
											onrightclick = "[CMMExecuteGuiSuffix('CMM_MarkListFieldSlot_', GetVariableSystem.Get('cmm_list_hover_field_slot'))]"
											onrightclick = "[CMMExecuteGuiSuffix('CMM_MarkSliderSelection_', ToString_int32(Multiply_int32(Add_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)1'), '(int32)5')))]"
											onrightclick = "[CMMExecuteGui('CMM_MarkListFieldSliderAll')]"
											onrightclick = "[CMMExecuteListItemSettingChanged(Scope.GetFlagName)]"
											onrightclick = "[PdxGuiTriggerAllAnimations('cmm_recache_delay')]"

											click_modifiers = {
												ondefault = "[CMMExecuteGuiSuffix('CMM_MarkListPosition_', GetVariableSystem.Get('cmm_list_hover_index'))]"
												ondefault = "[CMMExecuteGuiSuffix('CMM_MarkListFieldSlot_', GetVariableSystem.Get('cmm_list_hover_field_slot'))]"
												ondefault = "[CMMExecuteGuiSuffix('CMM_MarkSliderSelection_', ToString_int32(Multiply_int32(Add_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)1'), '(int32)5')))]"
												ondefault = "[CMMExecuteListItemSettingChanged(Scope.GetFlagName)]"
												ondefault = "[PdxGuiTriggerAllAnimations('cmm_recache_delay')]"
											}

											tooltip_enabled = no
										}
									}
								}
							}
						}

						widget = {
							size = { 3 20 }
							minimumsize = { 3 20 }
							allow_outside = yes
							onmousehierarchyenter = "[GetVariableSystem.Set('cmm_slider_hover_key', Scope.GetFlagName)]"
							onmousehierarchyenter = "[GetVariableSystem.Set('cmm_slider_hover_idx', '100')]"
							onmousehierarchyenter = "[CMMExecuteGuiSuffix('CMM_MarkListPosition_', GetVariableSystem.Get('cmm_list_hover_index'))]"
							onmousehierarchyenter = "[CMMExecuteGuiSuffix('CMM_MarkListFieldSlot_', GetVariableSystem.Get('cmm_list_hover_field_slot'))]"
							onmousehierarchyenter = "[CMMExecuteGui('CMM_SliderDragHover_100')]"
							onmousehierarchyenter = "[CMMExecuteListItemSettingChanged(Scope.GetFlagName)]"
							onmousehierarchyenter = "[PdxGuiTriggerAllAnimations('cmm_recache_delay')]"

							button = {
								size = { 100% 20 }
								alpha = 0
								effectname = "NoHighlight"
								onpressed = "[CMMExecuteGui('CMM_StartSliderDrag')]"
								onpressed = "[CMMExecuteGuiSuffix('CMM_MarkListPosition_', GetVariableSystem.Get('cmm_list_hover_index'))]"
								onpressed = "[CMMExecuteGuiSuffix('CMM_MarkListFieldSlot_', GetVariableSystem.Get('cmm_list_hover_field_slot'))]"
								onpressed = "[CMMExecuteGui('CMM_MarkSliderSelection_100')]"
								onpressed = "[CMMExecuteListItemSettingChanged(Scope.GetFlagName)]"
								onpressed = "[PdxGuiTriggerAllAnimations('cmm_recache_delay')]"
								onreleased = "[CMMExecuteGui('CMM_StopSliderDrag')]"
								tooltip_enabled = no
							}
						}
					}

				}

				widget = {
					position = { 0 0 }
					size = { 20 20 }
					minimumsize = { 20 20 }

					EconomySlider_DecButton = {
						size = { 20 20 }

						action_tooltip = {
							click_mode = single
							click_type = left
							click_modifier = default
							title = "CMM_LIST_NUMERIC_DECREASE"
						}

						action_tooltip = {
							click_mode = single
							click_type = left
							click_modifier = ctrl
							title = "CMM_LIST_NUMERIC_DECREASE_5X"
						}

						action_tooltip = {
							click_mode = single
							click_type = left
							click_modifier = shift
							title = "CMM_NUMERIC_DECREASE_MIN"
						}

						click_modifiers = {
							ondefault = "[CMMExecuteGuiSuffix('CMM_MarkListPosition_', GetVariableSystem.Get('cmm_list_hover_index'))]"
							ondefault = "[CMMExecuteGuiSuffix('CMM_MarkListFieldSlot_', GetVariableSystem.Get('cmm_list_hover_field_slot'))]"
							ondefault = "[CMMExecuteGui('CMM_MarkNumericDecrease')]"
							ondefault = "[CMMExecuteListItemSettingChanged(Scope.GetFlagName)]"
							ondefault = "[PdxGuiTriggerAllAnimations('cmm_recache_delay')]"
							onctrl = "[CMMExecuteGuiSuffix('CMM_MarkListPosition_', GetVariableSystem.Get('cmm_list_hover_index'))]"
							onctrl = "[CMMExecuteGuiSuffix('CMM_MarkListFieldSlot_', GetVariableSystem.Get('cmm_list_hover_field_slot'))]"
							onctrl = "[CMMExecuteGui('CMM_MarkNumericDecrease5x')]"
							onctrl = "[CMMExecuteListItemSettingChanged(Scope.GetFlagName)]"
							onctrl = "[PdxGuiTriggerAllAnimations('cmm_recache_delay')]"
							onshift = "[CMMExecuteGuiSuffix('CMM_MarkListPosition_', GetVariableSystem.Get('cmm_list_hover_index'))]"
							onshift = "[CMMExecuteGuiSuffix('CMM_MarkListFieldSlot_', GetVariableSystem.Get('cmm_list_hover_field_slot'))]"
							onshift = "[CMMExecuteGui('CMM_MarkNumericDecreaseToMin')]"
							onshift = "[CMMExecuteListItemSettingChanged(Scope.GetFlagName)]"
							onshift = "[PdxGuiTriggerAllAnimations('cmm_recache_delay')]"
						}

						tooltipwidget = {
							BasicFunctionalTooltip = {}
						}
					}
				}

				widget = {
					position = { 140 0 }
					size = { 20 20 }
					minimumsize = { 20 20 }

					EconomySlider_IncButton = {
						size = { 20 20 }

						action_tooltip = {
							click_mode = single
							click_type = left
							click_modifier = default
							title = "CMM_LIST_NUMERIC_INCREASE"
						}

						action_tooltip = {
							click_mode = single
							click_type = left
							click_modifier = ctrl
							title = "CMM_LIST_NUMERIC_INCREASE_5X"
						}

						action_tooltip = {
							click_mode = single
							click_type = left
							click_modifier = shift
							title = "CMM_NUMERIC_INCREASE_MAX"
						}

						click_modifiers = {
							ondefault = "[CMMExecuteGuiSuffix('CMM_MarkListPosition_', GetVariableSystem.Get('cmm_list_hover_index'))]"
							ondefault = "[CMMExecuteGuiSuffix('CMM_MarkListFieldSlot_', GetVariableSystem.Get('cmm_list_hover_field_slot'))]"
							ondefault = "[CMMExecuteGui('CMM_MarkNumericIncrease')]"
							ondefault = "[CMMExecuteListItemSettingChanged(Scope.GetFlagName)]"
							ondefault = "[PdxGuiTriggerAllAnimations('cmm_recache_delay')]"
							onctrl = "[CMMExecuteGuiSuffix('CMM_MarkListPosition_', GetVariableSystem.Get('cmm_list_hover_index'))]"
							onctrl = "[CMMExecuteGuiSuffix('CMM_MarkListFieldSlot_', GetVariableSystem.Get('cmm_list_hover_field_slot'))]"
							onctrl = "[CMMExecuteGui('CMM_MarkNumericIncrease5x')]"
							onctrl = "[CMMExecuteListItemSettingChanged(Scope.GetFlagName)]"
							onctrl = "[PdxGuiTriggerAllAnimations('cmm_recache_delay')]"
							onshift = "[CMMExecuteGuiSuffix('CMM_MarkListPosition_', GetVariableSystem.Get('cmm_list_hover_index'))]"
							onshift = "[CMMExecuteGuiSuffix('CMM_MarkListFieldSlot_', GetVariableSystem.Get('cmm_list_hover_field_slot'))]"
							onshift = "[CMMExecuteGui('CMM_MarkNumericIncreaseToMax')]"
							onshift = "[CMMExecuteListItemSettingChanged(Scope.GetFlagName)]"
							onshift = "[PdxGuiTriggerAllAnimations('cmm_recache_delay')]"
