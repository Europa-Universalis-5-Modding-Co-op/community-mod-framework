types CMMListSettingFieldTypes
{
	# Ordered list header field labels with a per-column right-click apply-to-all control.
	# Reads:
	# - Scope.GetFlagName [string]: current list setting key (`<mod_id>__<setting_id>`).
	# - PdxGuiWidget.GetIndexInDataModel [int32]: current field slot index in the repeated header datamodel.
	# - Player.MakeScope.GetVariable(Concatenate('cmm_list_field_<slot>_name_', Scope.GetFlagName)) [flag]: localized field header key.
	# Writes:
	# - GetVariableSystem.Set('cmm_list_hover_field_slot', ...) [effect]: caches the hovered header field slot.
	# - GetScriptedGui('CMM_MarkListColumnApplyAll').Execute(...) [effect]: marks the column apply-to-all action.
	# - GetScriptedGui(Concatenate(<setting_key>, '_on_changed')).Execute(...) [effect]: applies the queued list change.
	type cmm_list_setting_header_fields = hbox {
		ignoreinvisible = yes
		spacing = 8
		datamodel = "[DataModelRepeatedItem(CMMListFieldCount(Scope.GetFlagName))]"
		datamodel_reuse_widgets = yes

		item = {
			widget = {
				min_width = "[CMMListFieldWidth(Scope.GetFlagName, ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))]"
				minimumsize = { 0 20 }
				onmousehierarchyenter = "[GetVariableSystem.Set('cmm_list_hover_field_slot', ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))]"
				tagtooltip_enabled = yes
				tooltip = "[CMMListFieldDescText(Scope.GetFlagName, ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))]"
				tooltip_enabled = "[CMMListFieldHasDesc(Scope.GetFlagName, ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))]"
				tooltipwidget = { BasicFunctionalTooltip = {} }

				text_single = {
					parentanchor = vcenter
					size = { 100% 0 }
					max_width = "[CMMListFieldHeaderMaxWidth(Scope.GetFlagName, ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))]"
					fontsize = 14
					autoresize = no
					default_format = "#medium"
					align = center|nobaseline
					text = "[CMMListFieldMetadataFlag(Scope.GetFlagName, ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)), '_name_')]"
				}

				button = {
					size = { 100% 100% }
					alpha = 0
					effectname = "NoHighlight"
					enabled = "[GetVariableSystem.HasValue('cmm_can_edit_list', 'yes')]"
					visible = "[Not(CMMListFieldIsData(Scope.GetFlagName, ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel))))]"
					tagtooltip_enabled = yes
					tooltip = "[CMMListFieldDescText(Scope.GetFlagName, ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))]"
					tooltip_enabled = "[CMMListFieldHasDesc(Scope.GetFlagName, ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))]"

					action_tooltip = {
						click_mode = single
						click_type = right
						title = "CMM_LIST_APPLY_COLUMN_TO_ALL"
						on_action = "[CMMExecuteGui('CMM_MarkListPosition_0')]"
						on_action = "[CMMExecuteGuiSuffix('CMM_MarkListFieldSlot_', GetVariableSystem.Get('cmm_list_hover_field_slot'))]"
						on_action = "[CMMExecuteGui('CMM_MarkListColumnApplyAll')]"
						on_action = "[CMMExecuteSettingChanged(Scope.GetFlagName)]"
						on_action = "[PdxGuiTriggerAllAnimations('cmm_recache_delay')]"
					}

					tooltipwidget = { BasicFunctionalTooltip = {} }
				}
			}
		}
	}

	# Ordered list row field cells rendered from the owner setting field count.
	# Reads:
	# - Scope.GetFlagName [string]: current ordered list item key (`<mod_id>__<setting_id>_item_<index>`).
	# - Player.MakeScope.GetVariable(Concatenate('cmm_list_item_owner_setting_', Scope.GetFlagName)) [flag]: owner setting key for the row item.
	# - Player.MakeScope.GetVariable(Concatenate('cmm_list_field_count_', <setting_key>)) [value]: registered field count.
	type cmm_list_setting_row_fields = hbox {
		ignoreinvisible = yes
		spacing = 8
		datamodel = "[DataModelRepeatedItem(CMMListFieldCount(CMMListItemOwnerSettingKey(Scope.GetFlagName)))]"
		datamodel_reuse_widgets = yes

		item = {
			cmm_list_setting_field_cell = {}
		}
	}

	# One ordered list field cell that shows the correct control for the current field type.
	# Reads:
	# - Scope.GetFlagName [string]: current ordered list item key.
	# - PdxGuiWidget.GetIndexInDataModel [int32]: current field slot index in the repeated field datamodel.
	# - Player.MakeScope.GetVariable(Concatenate('cmm_list_field_<slot>_type_', <setting_key>)) [value]: field type metadata.
	# Writes:
	# - GetVariableSystem.Set('cmm_list_hover_field_slot', ...) [effect]: caches the currently hovered field slot.
	type cmm_list_setting_field_cell = widget {
		minimumsize = { 0 28 }
		min_width = "[CMMListFieldWidth(CMMListItemOwnerSettingKey(Scope.GetFlagName), ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))]"
		max_width = 198
		onmousehierarchyenter = "[GetVariableSystem.Set('cmm_list_hover_field_slot', ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))]"

		state = {
			name = cmm_cache_field_cell
			trigger_on_create = yes
			on_start = "[GetVariableSystem.Set(Concatenate(Scope.GetFlagName, Concatenate('_tp_', ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))), ToString_int32(CMMListFieldMetadataInt(CMMListItemOwnerSettingKey(Scope.GetFlagName), ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)), '_type_')))]"
			on_start = "[GetVariableSystem.Set(Concatenate(Scope.GetFlagName, Concatenate('_hf_', ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))), ToString_int32(CMMListFieldMetadataInt(CMMListItemOwnerSettingKey(Scope.GetFlagName), ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)), '_has_format_')))]"
			on_start = "[GetVariableSystem.Set(Concatenate(Scope.GetFlagName, Concatenate('_isg_', ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))), Select_CString(CMMSettingIsGlobal(CMMListItemOwnerSettingKey(Scope.GetFlagName)), 'yes', 'no'))]"
			on_start = "[GetVariableSystem.Set(Concatenate(Scope.GetFlagName, Concatenate('_rpfx_', ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))), CMMListFieldResolvedPrefix(CMMListItemOwnerSettingKey(Scope.GetFlagName), Scope.GetFlagName, ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel))))]"
			on_start = "[GetVariableSystem.Set(Concatenate(Scope.GetFlagName, Concatenate('_rpofx_', ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))), CMMListFieldResolvedPostfix(CMMListItemOwnerSettingKey(Scope.GetFlagName), Scope.GetFlagName, ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel))))]"
		}

		# Inner container hides content for disabled fields while cell stays visible to preserve column alignment.
		widget = {
			size = { 100% 100% }
			visible = "[CMMListItemFieldIsEnabled(Scope.GetFlagName, ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))]"
			enabled = "[GetVariableSystem.HasValue('cmm_can_edit_list', 'yes')]"

			cmm_list_setting_bool_field = {
				visible = "[GetVariableSystem.HasValue(Concatenate(Scope.GetFlagName, Concatenate('_tp_', ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))), '1')]"
			}

			cmm_list_setting_numeric_field = {
				visible = "[GetVariableSystem.HasValue(Concatenate(Scope.GetFlagName, Concatenate('_tp_', ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))), '3')]"
			}

			cmm_list_setting_dropdown_field = {
				visible = "[GetVariableSystem.HasValue(Concatenate(Scope.GetFlagName, Concatenate('_tp_', ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))), '2')]"
			}

			cmm_list_setting_slider_field = {
				visible = "[GetVariableSystem.HasValue(Concatenate(Scope.GetFlagName, Concatenate('_tp_', ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))), '4')]"
			}

			cmm_list_setting_data_field = {
				visible = "[GetVariableSystem.HasValue(Concatenate(Scope.GetFlagName, Concatenate('_tp_', ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))), '5')]"
			}
		}
	}

	# Ordered list bool field control with optional right-click-apply-to-all behavior.
	# Reads:
	# - Scope.GetFlagName [string]: current ordered list item key.
	# - PdxGuiWidget.GetIndexInDataModel [int32]: current field slot index in the repeated field datamodel.
	# - Player.MakeScope.GetVariable(Concatenate(Scope.GetFlagName, '_field_<slot>')) [value]: current bool field value for this row item.
	# - GetVariableSystem.Get('cmm_list_hover_field_slot') [string]: cached hovered field slot for nested button actions.
	# Writes:
	# - GetScriptedGui('CMM_MarkListPosition_<index>').Execute(...) [effect]: marks the hovered row position.
	# - GetScriptedGui('CMM_MarkListFieldSlot_<slot>').Execute(...) [effect]: marks the clicked field slot.
	# - GetScriptedGui('CMM_MarkListFieldToggle').Execute(...) [effect]: marks a single-row bool toggle.
	# - GetScriptedGui('CMM_MarkListFieldToggleAll').Execute(...) [effect]: marks a bulk bool toggle.
	# - GetScriptedGui(Concatenate(<setting_key>, '_on_changed')).Execute(...) [effect]: applies the queued list change.
	type cmm_list_setting_bool_field = widget {
		size = { 48 28 }
		minimumsize = { 48 28 }

		checkbox_square_alt = {
			parentanchor = center
			widgetanchor = center
			down = "[CMMValueEqualsOne(CMMListItemFieldValue(Scope.GetFlagName, ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel))))]"
			tooltip_enabled = no
		}

		button = {
			size = { 24 24 }
			parentanchor = center
			widgetanchor = center
			alpha = 0
			effectname = "NoHighlight"

			action_tooltip = {
				click_mode = single
				click_type = left
				title = "CMM_LIST_TOGGLE"
				on_action = "[CMMExecuteGuiSuffix('CMM_MarkListPosition_', GetVariableSystem.Get('cmm_list_hover_index'))]"
				on_action = "[CMMExecuteGuiSuffix('CMM_MarkListFieldSlot_', GetVariableSystem.Get('cmm_list_hover_field_slot'))]"
				on_action = "[CMMExecuteGui('CMM_MarkListFieldToggle')]"
				on_action = "[CMMExecuteListItemSettingChanged(Scope.GetFlagName)]"
				on_action = "[PdxGuiTriggerAllAnimations('cmm_recache_delay')]"
			}

			action_tooltip = {
				click_mode = single
				click_type = right
				title = "CMM_LIST_TOGGLE_ALL"
				on_action = "[CMMExecuteGuiSuffix('CMM_MarkListPosition_', GetVariableSystem.Get('cmm_list_hover_index'))]"
				on_action = "[CMMExecuteGuiSuffix('CMM_MarkListFieldSlot_', GetVariableSystem.Get('cmm_list_hover_field_slot'))]"
				on_action = "[CMMExecuteGui('CMM_MarkListFieldToggleAll')]"
				on_action = "[CMMExecuteListItemSettingChanged(Scope.GetFlagName)]"
				on_action = "[PdxGuiTriggerAllAnimations('cmm_recache_delay')]"
			}

			tooltipwidget = {
				BasicFunctionalTooltip = {}
			}
		}
	}

	# Ordered list numeric field control with shared numeric markers and right-click-apply-to-all behavior.
	# Reads:
	# - Scope.GetFlagName [string]: current ordered list item key.
	# - PdxGuiWidget.GetIndexInDataModel [int32]: current field slot index in the repeated field datamodel.
	# - Player.MakeScope.GetVariable(Concatenate(Scope.GetFlagName, '_field_<slot>')) [value]: current numeric field value for this row item.
	# - Player.MakeScope.GetVariable(Concatenate('cmm_list_field_<slot>_min_', <setting_key>)) [value]: numeric minimum bound.
	# - Player.MakeScope.GetVariable(Concatenate('cmm_list_field_<slot>_max_', <setting_key>)) [value]: numeric maximum bound.
	# - GetVariableSystem.Get('cmm_list_hover_field_slot') [string]: cached hovered field slot for nested button actions and tooltip text.
	# Writes:
	# - GetScriptedGui('CMM_MarkListPosition_<index>').Execute(...) [effect]: marks the hovered row position.
	# - GetScriptedGui('CMM_MarkListFieldSlot_<slot>').Execute(...) [effect]: marks the clicked field slot.
	# - GetScriptedGui('CMM_MarkNumeric*').Execute(...) [effect]: marks numeric step or min/max mode.
	# - GetScriptedGui('CMM_MarkListFieldSelectNumericAll').Execute(...) [effect]: marks bulk numeric apply.
	# - GetScriptedGui(Concatenate(<setting_key>, '_on_changed')).Execute(...) [effect]: applies the queued list change.
	type cmm_list_setting_numeric_field = hbox {
		minimumsize = { 120 25 }
		spacing = 0

		button_square_minus = {
			size = { 25 25 }
			blockoverride "square_icon_size" {
				size = { 75% 75% }
			}

			action_tooltip = {
				click_mode = single
				click_type = left
				click_modifier = default
				title = "CMM_LIST_NUMERIC_DECREASE"
			}

			action_tooltip = {
				click_mode = single
				click_type = left
				click_modifier = ctrl
				title = "CMM_LIST_NUMERIC_DECREASE_5X"
			}

			action_tooltip = {
				click_mode = single
				click_type = left
				click_modifier = shift
				title = "CMM_NUMERIC_DECREASE_MIN"
			}

			click_modifiers = {
				ondefault = "[CMMExecuteGuiSuffix('CMM_MarkListPosition_', GetVariableSystem.Get('cmm_list_hover_index'))]"
				ondefault = "[CMMExecuteGuiSuffix('CMM_MarkListFieldSlot_', GetVariableSystem.Get('cmm_list_hover_field_slot'))]"
				ondefault = "[CMMExecuteGui('CMM_MarkNumericDecrease')]"
				ondefault = "[CMMExecuteListItemSettingChanged(Scope.GetFlagName)]"
				ondefault = "[PdxGuiTriggerAllAnimations('cmm_recache_delay')]"
				onctrl = "[CMMExecuteGuiSuffix('CMM_MarkListPosition_', GetVariableSystem.Get('cmm_list_hover_index'))]"
				onctrl = "[CMMExecuteGuiSuffix('CMM_MarkListFieldSlot_', GetVariableSystem.Get('cmm_list_hover_field_slot'))]"
				onctrl = "[CMMExecuteGui('CMM_MarkNumericDecrease5x')]"
				onctrl = "[CMMExecuteListItemSettingChanged(Scope.GetFlagName)]"
				onctrl = "[PdxGuiTriggerAllAnimations('cmm_recache_delay')]"
				onshift = "[CMMExecuteGuiSuffix('CMM_MarkListPosition_', GetVariableSystem.Get('cmm_list_hover_index'))]"
				onshift = "[CMMExecuteGuiSuffix('CMM_MarkListFieldSlot_', GetVariableSystem.Get('cmm_list_hover_field_slot'))]"
				onshift = "[CMMExecuteGui('CMM_MarkNumericDecreaseToMin')]"
				onshift = "[CMMExecuteListItemSettingChanged(Scope.GetFlagName)]"
				onshift = "[PdxGuiTriggerAllAnimations('cmm_recache_delay')]"
			}

			tooltipwidget = {
				BasicFunctionalTooltip = {}
			}
		}

		widget = {
			size = { -1 25 }
			# margin = { 4 0 }
			layoutpolicy_horizontal = expanding

			using = bg_text_mask_container_dark_blue

			button = {
				size = { 100% 100% }
				alpha = 0
				effectname = "NoHighlight"
				tooltip_enabled = yes

				action_tooltip = {
					click_mode = single
					click_type = right
					title = "CMM_LIST_APPLY_NUMBER_TO_ALL"
					on_action = "[CMMExecuteGuiSuffix('CMM_MarkListPosition_', GetVariableSystem.Get('cmm_list_hover_index'))]"
					on_action = "[CMMExecuteGuiSuffix('CMM_MarkListFieldSlot_', GetVariableSystem.Get('cmm_list_hover_field_slot'))]"
					on_action = "[CMMExecuteGui('CMM_MarkListFieldSelectNumericAll')]"
					on_action = "[CMMExecuteListItemSettingChanged(Scope.GetFlagName)]"
					on_action = "[PdxGuiTriggerAllAnimations('cmm_recache_delay')]"
				}

				tooltipwidget = {
					ContextualTooltipType = {
						blockoverride "tooltip_title" {}
						blockoverride "tooltip_content_margin" { margin = { 10 6 } }
						blockoverride "tooltip_content" {
							hbox = {
								set_parent_size_to_minimum = yes

								textbox = {
									using = text_single_template
									align = left|nobaseline
									raw_text = "[CMMListFieldMetadataValue(CMMListItemOwnerSettingKey(Scope.GetFlagName), GetVariableSystem.Get('cmm_list_hover_field_slot'), '_min_')] - [CMMListFieldMetadataValue(CMMListItemOwnerSettingKey(Scope.GetFlagName), GetVariableSystem.Get('cmm_list_hover_field_slot'), '_max_')]"
								}
							}
						}
					}
				}
			}

			text_single = {
				size = { 100% 100% }
				align = center|nobaseline
				autoresize = no
				visible = "[GetVariableSystem.HasValue(Concatenate(Scope.GetFlagName, Concatenate('_hf_', ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))), '0')]"
				text = "[CMMListItemFieldValue(Scope.GetFlagName, ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))]"
			}
			text_single = {
				size = { 100% 100% }
				align = center|nobaseline
				autoresize = no
				visible = "[Not(GetVariableSystem.HasValue(Concatenate(Scope.GetFlagName, Concatenate('_hf_', ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))), '0'))]"
				text = "[CMMCachedResolvedPrefix(Scope.GetFlagName, ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))][CMMListItemFieldValue(Scope.GetFlagName, ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))][CMMCachedResolvedPostfix(Scope.GetFlagName, ToString_int32(CMMWidgetIndexToOrdinal(PdxGuiWidget.GetIndexInDataModel)))]"
			}
		}

		button_square_plus = {
			size = { 25 25 }
			blockoverride "square_icon_size" {
				size = { 75% 75% }
			}

			action_tooltip = {
				click_mode = single
				click_type = left
				click_modifier = default
				title = "CMM_LIST_NUMERIC_INCREASE"
			}

			action_tooltip = {
				click_mode = single
				click_type = left
				click_modifier = ctrl
				title = "CMM_LIST_NUMERIC_INCREASE_5X"
			}

			action_tooltip = {
				click_mode = single
				click_type = left
				click_modifier = shift
				title = "CMM_NUMERIC_INCREASE_MAX"
			}

			click_modifiers = {
				ondefault = "[CMMExecuteGuiSuffix('CMM_MarkListPosition_', GetVariableSystem.Get('cmm_list_hover_index'))]"
				ondefault = "[CMMExecuteGuiSuffix('CMM_MarkListFieldSlot_', GetVariableSystem.Get('cmm_list_hover_field_slot'))]"
				ondefault = "[CMMExecuteGui('CMM_MarkNumericIncrease')]"
				ondefault = "[CMMExecuteListItemSettingChanged(Scope.GetFlagName)]"
				ondefault = "[PdxGuiTriggerAllAnimations('cmm_recache_delay')]"
				onctrl = "[CMMExecuteGuiSuffix('CMM_MarkListPosition_', GetVariableSystem.Get('cmm_list_hover_index'))]"
				onctrl = "[CMMExecuteGuiSuffix('CMM_MarkListFieldSlot_', GetVariableSystem.Get('cmm_list_hover_field_slot'))]"
				onctrl = "[CMMExecuteGui('CMM_MarkNumericIncrease5x')]"
				onctrl = "[CMMExecuteListItemSettingChanged(Scope.GetFlagName)]"
				onctrl = "[PdxGuiTriggerAllAnimations('cmm_recache_delay')]"
				onshift = "[CMMExecuteGuiSuffix('CMM_MarkListPosition_', GetVariableSystem.Get('cmm_list_hover_index'))]"
				onshift = "[CMMExecuteGuiSuffix('CMM_MarkListFieldSlot_', GetVariableSystem.Get('cmm_list_hover_field_slot'))]"
				onshift = "[CMMExecuteGui('CMM_MarkNumericIncreaseToMax')]"
				onshift = "[CMMExecuteListItemSettingChanged(Scope.GetFlagName)]"
				onshift = "[PdxGuiTriggerAllAnimations('cmm_recache_delay')]"
			}

			tooltipwidget = {
				BasicFunctionalTooltip = {}
			}
		}
	}

	# Ordered list dropdown field control with per-slot dropdown variants and right-click-apply-to-all behavior.
	# Reads:
	# - Scope.GetFlagName [string]: current ordered list item key.
	# - PdxGuiWidget.GetIndexInDataModel [int32]: current field slot index in the repeated field datamodel or current 0-based widget dropdown option index in option rows.
	# - Player.MakeScope.GetVariable(Concatenate(Scope.GetFlagName, '_field_<slot>')) [value]: current 1-based dropdown field ordinal for this row item.
	# - Player.MakeScope.GetVariable(Concatenate('cmm_list_field_<slot>_dropdown_count_', <setting_key>)) [value]: dropdown option count.
	# - Player.MakeScope.GetVariable(Concatenate('cmm_list_field_<slot>_option_root_', <setting_key>)) [flag]: dropdown option localization root.
	# - GetVariableSystem.Get('cmm_dropdown_hover_index') [string]: cached hovered 0-based widget dropdown option index.
	# Writes:
	# - GetVariableSystem.Set('cmm_dropdown_hover_index', ...) [effect]: caches the hovered 0-based widget dropdown option index.
	# - GetScriptedGui('CMM_MarkListPosition_<index>').Execute(...) [effect]: marks the hovered row position.
	# - GetScriptedGui('CMM_MarkListFieldSlot_<slot>').Execute(...) [effect]: marks the clicked field slot.
	# - GetScriptedGui('CMM_MarkListFieldSelectDropdown').Execute(...) [effect]: marks a single-row dropdown selection.
	# - GetScriptedGui('CMM_MarkListFieldSelectDropdownAll').Execute(...) [effect]: marks a bulk dropdown selection.
	# - GetScriptedGui('CMM_MarkDropdownSelection_<index>').Execute(...) [effect]: marks the selected widget option index and stores a 1-based public ordinal.
	# - GetScriptedGui(Concatenate(<setting_key>, '_on_changed')).Execute(...) [effect]: applies the queued list change.
	type cmm_list_setting_dropdown_field = widget {
		size = { 132 28 }
		minimumsize = { 132 28 }

		dropDown = {
			size = { 132 28 }
			minimumsize = { 132 28 }
			parentanchor = center
			widgetanchor = center
			visible = "[EqualTo_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)0')]"
			alwaystransparent = no
			datamodel = "[DataModelRepeatedItem(CMMListFieldMetadataInt(CMMListItemOwnerSettingKey(Scope.GetFlagName), '1', '_dropdown_count_'))]"
			selectedindex = "[CMMListItemFieldWidgetIndex(Scope.GetFlagName, '1')]"
			onselectionchanged = "[CMMExecuteGuiSuffix('CMM_MarkListPosition_', GetVariableSystem.Get('cmm_list_hover_index'))]"
			onselectionchanged = "[CMMExecuteGuiSuffix('CMM_MarkListFieldSlot_', '1')]"
			onselectionchanged = "[CMMExecuteGui('CMM_MarkListFieldSelectDropdown')]"
			onselectionchanged = "[CMMExecuteGuiSuffix('CMM_MarkDropdownSelection_', GetVariableSystem.Get('cmm_dropdown_hover_index'))]"
			onselectionchanged = "[CMMExecuteListItemSettingChanged(Scope.GetFlagName)]"
			onselectionchanged = "[PdxGuiTriggerAllAnimations('cmm_recache_delay')]"

			active_item = {
				widget = {
					size = { 100% 28 }

					button_drop = {
						onclick = "[GetVariableSystem.Set('cmm_dropdown_hover_index', ToString_int32(CMMListItemFieldWidgetIndex(Scope.GetFlagName, '1')))]"
						tooltip_enabled = no

						action_tooltip = {
							click_mode = single
							click_type = left
							title = "CMM_LIST_SELECT_OPTION"
						}

						action_tooltip = {
							click_mode = single
							click_type = right
							title = "CMM_LIST_APPLY_OPTION_TO_ALL"
							on_action = "[CMMExecuteGuiSuffix('CMM_MarkListPosition_', GetVariableSystem.Get('cmm_list_hover_index'))]"
							on_action = "[CMMExecuteGuiSuffix('CMM_MarkListFieldSlot_', '1')]"
							on_action = "[CMMExecuteGui('CMM_MarkListFieldSelectDropdownAll')]"
							on_action = "[CMMExecuteGuiSuffix('CMM_MarkDropdownSelection_', ToString_int32(CMMListItemFieldWidgetIndex(Scope.GetFlagName, '1')))]"
							on_action = "[CMMExecuteListItemSettingChanged(Scope.GetFlagName)]"
							on_action = "[PdxGuiTriggerAllAnimations('cmm_recache_delay')]"
						}

						tooltipwidget = { BasicFunctionalTooltip = {} }
					}

					hbox = {
