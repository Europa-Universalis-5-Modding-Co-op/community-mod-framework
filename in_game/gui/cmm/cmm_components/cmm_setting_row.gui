types CMMSettingRowTypes
{
	# Single setting row for bool, button, text, numeric, dropdown, slider, and list settings.
	# Reads:
	# - Scope.GetFlagName [string]: current setting key (`<mod_id>__<setting_id>`).
	# - GetVariableSystem.Get('cmm_selected_mod') [string]: active mod id for row visibility filtering.
	# - GetVariableSystem.Get('cmm_selected_tab') [string]: active tab key for row visibility filtering.
	# - GetGlobalVariable(Scope.GetFlagName).GetValue [value]: current setting value for global settings.
	# - Player.MakeScope.GetVariable(Scope.GetFlagName) [value]: current setting value for local settings.
	# - Player.MakeScope.GetVariable(Concatenate(Scope.GetFlagName, '_text')) [flag]: localized button caption for button settings.
	# - Player.MakeScope.GetVariable(Concatenate(Scope.GetFlagName, '_desc')) [flag]: localized setting description used by hover tooltips.
	# - Player.MakeScope.GetVariable(Concatenate('cmm_setting_min_', Scope.GetFlagName)) [value]: numeric minimum bound.
	# - Player.MakeScope.GetVariable(Concatenate('cmm_setting_max_', Scope.GetFlagName)) [value]: numeric maximum bound.
	# - Player.MakeScope.GetVariable(Concatenate('cmm_setting_text_character_limit_', Scope.GetFlagName)) [value]: text character limit.
	# - Player.MakeScope.GetVariable(Concatenate('cmm_setting_slider_visual_step_count_', Scope.GetFlagName)) [value]: slider visual slot count.
	# - Player.MakeScope.GetList(Concatenate('cmm_list_items_', Scope.GetFlagName)) [list<flag>]: ordered item keys for list settings.
	# Writes:
	# - ExecuteConsoleCommand(...) [effect]: submits text settings through console-backed effect calls.
	# - GetScriptedGui('cmm_auto_*').Execute(...) [effect]: applies setting changes via auto-apply scripted GUIs.
	# - GetScriptedGui('CMM_MarkNumeric*').Execute(...) [effect]: stores pending numeric delta mode.
	# - GetScriptedGui('CMM_MarkDropdownSelection_<index>').Execute(...) [effect]: stores pending dropdown selected index.
	# - GetScriptedGui('CMM_MarkSliderSelection_<index>').Execute(...) [effect]: stores pending slider visual index.
	# - GetScriptedGui('CMM_MarkList*').Execute(...) [effect]: stores pending list position, list action, and field-slot markers.
	type cmm_setting_row = vbox {
		layoutpolicy_horizontal = expanding
		minimumsize = { 0 60 }
		ignoreinvisible = yes
		using = bg_window_default_alt
		visible = "[CMMCachedSettingRowVisible(Scope.GetFlagName)]"

		state = {
			name = cmm_cache_setting_row
			trigger_on_create = yes
			on_start = "[GetVariableSystem.Set(Concatenate(Scope.GetFlagName, '_srt'), ToString_int32(CMMMapInt('cmm_type', Scope.GetFlagName)))]"
			on_start = "[GetVariableSystem.Set(Concatenate(Scope.GetFlagName, '_srom'), CMMMetadataFlag('cmm_setting_owner_mod_id_', Scope.GetFlagName))]"
			on_start = "[GetVariableSystem.Set(Concatenate(Scope.GetFlagName, '_srot'), CMMMetadataFlag('cmm_setting_owner_tab_key_', Scope.GetFlagName))]"
			on_start = "[GetVariableSystem.Set(Concatenate(Scope.GetFlagName, '_srn'), CMMLocalizedSuffix(Scope.GetFlagName, '_name'))]"
			on_start = "[GetVariableSystem.Set(Concatenate(Scope.GetFlagName, '_srd'), CMMLocalizedSuffixText(Scope.GetFlagName, '_desc'))]"
			on_start = "[GetVariableSystem.Set(Concatenate(Scope.GetFlagName, '_srhd'), Select_CString(CMMHasLocalizedSuffixText(Scope.GetFlagName, '_desc'), 'yes', 'no'))]"
			on_start = "[GetVariableSystem.Set(Concatenate(Scope.GetFlagName, '_srisg'), Select_CString(CMMSettingIsGlobal(Scope.GetFlagName), 'yes', 'no'))]"
			on_start = "[GetVariableSystem.Set(Concatenate(Scope.GetFlagName, '_srrut'), Select_CString(CMMSettingRequiresUnrestrictedToolsEnabled(Scope.GetFlagName), 'yes', 'no'))]"
			on_start = "[GetVariableSystem.Set(Concatenate(Scope.GetFlagName, '_srsgui'), Select_CString(CMMHasScriptedGui(Scope.GetFlagName), 'yes', 'no'))]"
			on_start = "[GetVariableSystem.Set(Concatenate(Scope.GetFlagName, '_srmulti'), Select_CString(CMMDropdownIsMultiselector(Scope.GetFlagName), 'yes', 'no'))]"
			on_start = "[GetVariableSystem.Set(Concatenate(Scope.GetFlagName, '_srbtn'), CMMLocalizedSuffix(Scope.GetFlagName, '_text'))]"
			on_start = "[GetVariableSystem.Set(Concatenate(Scope.GetFlagName, '_srhf'), Select_CString(CMMHasFormat(Scope.GetFlagName), 'yes', 'no'))]"
		}

		hbox = {
			visible = "[Not(CMMCachedSettingTypeIs(Scope.GetFlagName, '7'))]"
			layoutpolicy_horizontal = expanding
			margin = { 12 4 }
			spacing = 12

			text_single = {
				layoutpolicy_horizontal = expanding
				tagtooltip_enabled = yes
				tooltip = "[CMMCachedSettingDesc(Scope.GetFlagName)]"
				tooltip_enabled = "[CMMCachedSettingHasDesc(Scope.GetFlagName)]"
				tooltipwidget = { BasicFunctionalTooltip = {} }
				text = "[CMMCachedSettingName(Scope.GetFlagName)]"
			}

			hbox = {
				minimumsize = { 320 0 }
				ignoreinvisible = yes

				checkbox_square_alt = {
					visible = "[And(CMMCachedSettingTypeIs(Scope.GetFlagName, '1'), Not(CMMSettingHasConsoleCommand(Scope.GetFlagName)))]"
					enabled = "[CMMCachedSettingEnabled(Scope.GetFlagName)]"
					onclick = "[CMMExecuteAutoApply('cmm_auto_toggle_bool', Scope.GetFlagName)]"
					down = "[CMMIsSettingEnabled(Scope.GetFlagName)]"
					tooltip_enabled = no
				}

				checkbox_square_alt = {
					visible = "[And(CMMCachedSettingTypeIs(Scope.GetFlagName, '1'), CMMSettingHasConsoleCommand(Scope.GetFlagName))]"
					enabled = "[CMMCachedSettingEnabled(Scope.GetFlagName)]"
					onclick = "[CMMExecuteAutoApply('cmm_auto_toggle_bool', Scope.GetFlagName)]"
					onclick = "[ExecuteConsoleCommand(CMMSettingConsoleCommand(Scope.GetFlagName))]"
					down = "[InDebugMode]"
					tooltip_enabled = no
				}

				button_regular = {
					visible = "[CMMCachedSettingTypeIs(Scope.GetFlagName, '6')]"
					minimumsize = { 168 32 }
					enabled = "[CMMCachedSettingEnabled(Scope.GetFlagName)]"
					text = "[CMMCachedSettingButtonText(Scope.GetFlagName)]"
					onclick = "[CMMExecuteAutoApply('cmm_auto_apply_button', Scope.GetFlagName)]"
					tooltip_enabled = no
				}

				cmm_dropdown_setting = {
					visible = "[And(CMMCachedSettingTypeIs(Scope.GetFlagName, '2'), Not(CMMCachedDropdownIsMultiselector(Scope.GetFlagName)))]"
				}

				cmm_multiselector_setting = {
					visible = "[And(CMMCachedSettingTypeIs(Scope.GetFlagName, '2'), CMMCachedDropdownIsMultiselector(Scope.GetFlagName))]"
				}

				cmm_text_setting = {
					visible = "[CMMCachedSettingTypeIs(Scope.GetFlagName, '5')]"
				}

				cmm_slider_setting = {
					visible = "[CMMCachedSettingTypeIs(Scope.GetFlagName, '4')]"
				}

				cmm_numeric_setting = {
					visible = "[CMMCachedSettingTypeIs(Scope.GetFlagName, '3')]"
				}

				expand = {}
			}
		}

		cmm_list_setting = {
			visible = "[CMMCachedSettingTypeIs(Scope.GetFlagName, '7')]"
		}
	}
}
