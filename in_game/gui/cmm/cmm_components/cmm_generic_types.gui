types = CMMGenericTypes {
	# Window-level close control for CMM.
	# Writes:
	# - GetVariableSystem.Clear('cmm_mod_search_text') [void]: clears transient search text on close.
	# - GetVariableSystem.Clear('cmm_window_open') [void]: closes the window.
	type cmm_window_close_widget = widget {
		parentanchor = right
		position = { -5 5 }
		size = { 40 40 }

		ui_direction_button_holder_right = {}

		button_close_alt = {
			blockoverride "close_on_action" {
				on_action = "[GetVariableSystem.Clear('cmm_mod_search_text')]"
				on_action = "[GetVariableSystem.Clear('cmm_window_open')]"
			}
		}
	}
}

