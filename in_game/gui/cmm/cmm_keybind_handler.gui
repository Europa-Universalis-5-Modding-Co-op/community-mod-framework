widget = {
	name = "cmm_keybind_handler"
	size = { 0 0 }
	datacontext = "[GetPlayer]"
	visible = "[Country.IsValid]"

	button = {
		visible = "[Or(Not(GameIsMultiplayer), IsHost)]"
		use_global_input_instance = yes
		input_action = "cmm_open_menu"
		on_input_action_shortcut = "[GetScriptedGui('CMM_SetHostAndRegisterCoreMod').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		on_input_action_shortcut = "[GetVariableSystem.Clear('cmm_mod_search_text')]"
		on_input_action_shortcut = "[GetVariableSystem.Set('cmm_selected_mod', Select_CString(CMMSelectedModExists, GetVariableSystem.Get('cmm_selected_mod'), 'cmf_core'))]"
		on_input_action_shortcut = "[GetVariableSystem.Set('cmm_selected_tab', Select_CString(CMMSelectedTabExists, GetVariableSystem.Get('cmm_selected_tab'), 'cmf_core__general'))]"
		on_input_action_shortcut = "[GetVariableSystem.Toggle('cmm_window_open')]"
		tooltip_enabled = no
	}

	button = {
		visible = "[And(GameIsMultiplayer, Not(IsHost))]"
		use_global_input_instance = yes
		input_action = "cmm_open_menu"
		on_input_action_shortcut = "[GetScriptedGui('CMM_RegisterCoreMod').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		on_input_action_shortcut = "[GetVariableSystem.Clear('cmm_mod_search_text')]"
		on_input_action_shortcut = "[GetVariableSystem.Set('cmm_selected_mod', Select_CString(CMMSelectedModExists, GetVariableSystem.Get('cmm_selected_mod'), 'cmf_core'))]"
		on_input_action_shortcut = "[GetVariableSystem.Set('cmm_selected_tab', Select_CString(CMMSelectedTabExists, GetVariableSystem.Get('cmm_selected_tab'), 'cmf_core__general'))]"
		on_input_action_shortcut = "[GetVariableSystem.Toggle('cmm_window_open')]"
		tooltip_enabled = no
	}
}
